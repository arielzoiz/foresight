+class Direction(Enum):
+    """Direction of an I/O port."""
+    Input  = 1
+    Output = 2
+    Bidir  = 3
+
+    def __or__(self, other):
+        if not isinstance(other, Direction):
+            raise TypeError(f"Direction can only be ORed with another Direction, not {other!r}")
+        if self == Direction.Input:
+            if other == Direction.Input:
+                return Direction.Input
+            elif other == Direction.Output:
+                return Direction.Bidir
+            elif other == Direction.Bidir:
+                return Direction.Bidir
+        elif self == Direction.Output:
+            if other == Direction.Input:
+                raise ValueError("Cannot combine input port with output port")
+            elif other == Direction.Output:
+                return Direction.Output
+            elif other == Direction.Bidir:
+                return Direction.Bidir
+        elif self == Direction.Bidir:
+            return Direction.Bidir
+        raise TypeError(f"Direction can only be ORed with another Direction, not {other!r}")
+
+    def __and__(self, other):
+        if not isinstance(other, Direction):
+            raise TypeError(f"Direction can only be ANDed with another Direction, not {other!r}")
+        if self == Direction.Input:
+            if other == Direction.Input:
+                return Direction.Input
+            elif other == Direction.Output:
+                raise ValueError("Cannot combine input port with output port")
+            elif other == Direction.Bidir:
+                return Direction.Input
+        elif self == Direction.Output:
+            if other == Direction.Input:
+                raise ValueError("Cannot combine input port with output port")
+            elif other == Direction.Output:
+                return Direction.Output
+            elif other == Direction.Bidir:
+                return Direction.Output
+        elif self == Direction.Bidir:
+            if other == Direction.Input:
+                return Direction.Input
+            elif other == Direction.Output:
+                return Direction.Output
+            elif other == Direction.Bidir:
+                return Direction.Bidir
+        raise TypeError(f"Direction can only be ANDed with another Direction, not {other!r}")
