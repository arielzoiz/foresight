+class IOPort(Value):
+    """An I/O port.
+
+    Parameters
+    ----------
+    width : int
+        Width of the port.
+    name : str or None
+        Name of the port.
+    attrs : dict or None
+        Dictionary of synthesis attributes.
+    metadata : list or None
+        List of metadata.
+    """
+    def __init__(self, width, name=None, attrs=None, metadata=None, *, src_loc_at=0):
+        super().__init__(src_loc_at=src_loc_at)
+        self._width = width
+        self._name = name
+        self._attrs = OrderedDict(() if attrs is None else attrs)
+        self._metadata = metadata or []
+
+    @property
+    def width(self):
+        return self._width
+
+    @property
+    def name(self):
+        return self._name
+
+    @property
+    def attrs(self):
+        return self._attrs
+
+    @property
+    def metadata(self):
+        return self._metadata
+
+    def _ioports(self):
+        """Get I/O ports.
+
+        Returns
+        -------
+        list of IOPort
+            List of I/O ports.
+        """
+        return [self]
+
+    def shape(self):
+        return Shape(self.width)
+
+    def _lhs_signals(self):
+        return SignalSet()
+
+    def _rhs_signals(self):
+        return SignalSet()
 
 
