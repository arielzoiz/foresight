+    def _assign_names_to_signals(self, fragment, ports):
+        """Assign names to signals in this fragment and its subfragments.
+        
+        Arguments
+        ---------
+        fragment : Fragment
+            Fragment to assign names to signals in.
+        ports : list of (name, signal, direction) or None
+            Ports to use for naming signals.
+        """
+        if fragment not in self.signal_names:
+            self.signal_names[fragment] = {}
+            
+        # Collect all signals in this fragment
+        signals = set()
+        
+        # Add signals from statements
+        for domain, stmts in fragment.statements.items():
+            for stmt in stmts:
+                signals.update(stmt._rhs_signals())
+                signals.update(stmt._lhs_signals())
+                
+        # Add signals from subfragments
+        for subfragment, _name, _src_loc in fragment.subfragments:
+            self._assign_names_to_signals(subfragment, None)
+            signals.update(self.signal_names[subfragment].keys())
+            
+        # Add ports as signals
+        if ports:
+            for name, signal, dir in ports:
+                signals.add(signal)
+        
+        # Assign names to signals
+        taken_names = set()
+        for signal in signals:
+            # Skip signals that already have names
+            if signal in self.signal_names[fragment]:
+                continue
+                
+            # Try to get name from signal
+            if hasattr(signal, 'name') and signal.name:
+                name = signal.name
+            else:
+                name = f"sig_{len(self.signal_names[fragment])}"
+                
+            # Make sure the name is unique
+            original_name = name
+            counter = 0
+            while name in taken_names:
+                counter += 1
+                name = f"{original_name}_{counter}"
+                
+            taken_names.add(name)
+            self.signal_names[fragment][signal] = name
+
 
