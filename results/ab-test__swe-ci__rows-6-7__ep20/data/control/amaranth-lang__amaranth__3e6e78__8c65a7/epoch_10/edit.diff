+    def _ioports(self):
+        """Get I/O ports.
+        
+        Returns
+        -------
+        list of IOPort
+            List of I/O ports.
+        """
+        ioports = []
+        for part in self.parts:
+            if hasattr(part, '_ioports'):
+                part_ioports = part._ioports()
+                if isinstance(part_ioports, list):
+                    # Add each IOPort from the list to our result
+                    for p in part_ioports:
+                        # Check for duplicates and avoid adding the same port twice
+                        already_added = False
+                        for existing in ioports:
+                            if existing is p:  # Identity comparison
+                                already_added = True
+                                break
+                        if not already_added:
+                            ioports.append(p)
+                else:
+                    # If it's not a list, treat it as a single IOPort
+                    already_added = False
+                    for existing in ioports:
+                        if existing is part_ioports:  # Identity comparison
+                            already_added = True
+                            break
+                    if not already_added:
+                        ioports.append(part_ioports)
+        return ioports
 
     def __repr__(self):
         return "(cat {})".format(" ".join(map(repr, self.parts)))
