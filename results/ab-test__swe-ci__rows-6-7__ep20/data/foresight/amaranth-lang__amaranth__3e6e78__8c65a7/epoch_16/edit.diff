+class SingleEndedPort(ValueCastable):
+    """A single-ended I/O port.
+    
+    A single-ended port consists of a single I/O port that can be used for input, output, or
+    bidirectional operations.
+    
+    Parameters
+    ----------
+    io : IOPort
+        The underlying I/O port.
+    invert : bool or iterable of bool
+        Whether each bit should be inverted. If a single bool, all bits are inverted. If an
+        iterable, each element corresponds to a bit.
+    direction : Direction
+        The direction of the port.
+    """
+    
+    def __init__(self, io, invert=False, direction=Direction.FANIN):
+        io = Value.cast(io)
+        if not isinstance(io, IOPort):
+            raise TypeError(f"Object {io!r} cannot be converted to an IO value")
+        
+        if isinstance(invert, bool):
+            invert = [invert] * len(io)
+        elif isinstance(invert, (list, tuple)):
+            if len(invert) != len(io):
+                raise ValueError(f"Length of 'invert' ({len(invert)}) doesn't match length of 'io' ({len(io)})")
+            invert = list(invert)
+            for i, inv in enumerate(invert):
+                if not isinstance(inv, bool):
+                    raise TypeError(f"'invert' must be a bool or iterable of bool, not {invert!r}")
+        else:
+            raise TypeError(f"'invert' must be a bool or iterable of bool, not {invert!r}")
+            
+        if isinstance(direction, str):
+            # Map string representations to Direction values
+            direction_map = {
+                'i': Direction.FANIN,
+                'o': Direction.FANOUT,
+                'io': Direction.NONE,
+                'bidir': Direction.NONE
+            }
+            direction = direction_map.get(direction.lower(), Direction.NONE)
+        elif not isinstance(direction, Direction):
+            raise ValueError(f"'{direction}' is not a valid Direction")
+            
+        self.io = io
+        self.invert = tuple(invert)
+        self.direction = direction
+    
+    def shape(self):
+        return Shape(len(self.io))
+    
+    def as_value(self):
+        return self.io
+    
+    def __len__(self):
+        return len(self.io)
+    
+    def __getitem__(self, key):
+        sliced = self.io[key]
+        if isinstance(sliced, IOSlice):
+            invert = self.invert[key]
+            return SingleEndedPort(sliced, invert=invert, direction=self.direction)
+        else:
+            # This is a single bit
+            invert = self.invert[key]
+            return SingleEndedPort(sliced, invert=invert, direction=self.direction)
+    
+    def __add__(self, other):
+        if not isinstance(other, SingleEndedPort):
+            raise TypeError("Can only concatenate SingleEndedPort with SingleEndedPort")
+        if self.direction != other.direction:
+            raise ValueError("Cannot concatenate ports with different directions")
+        return SingleEndedPort(
+            Cat(self.io, other.io),
+            invert=self.invert + other.invert,
+            direction=self.direction
+        )
+    
+    def __invert__(self):
+        return SingleEndedPort(
+            self.io,
+            invert=[not inv for inv in self.invert],
+            direction=self.direction
+        )
+    
+    def __repr__(self):
+        invert = self.invert if len(self.invert) > 1 else self.invert[0]
+        return f"SingleEndedPort({self.io!r}, invert={invert!r}, direction={self.direction!r})"
+
