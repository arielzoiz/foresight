+            direction_map = {
+                'i': Direction.FANIN,
+                'o': Direction.FANOUT,
+                'io': Direction.NONE,
+                'bidir': Direction.NONE
+            }
+            direction = direction_map.get(direction.lower(), Direction.NONE)
+        elif not isinstance(direction, Direction):
+            raise ValueError(f"'{direction}' is not a valid Direction")
