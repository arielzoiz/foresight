+    def lookup_domain(self, name: str, fragment: Fragment):
+        """Look up a domain by name in the design.
+
+        This method resolves domain names considering domain renamings and hierarchies.
+        """
+        # Search for the fragment in the design hierarchy
+        # The fragment passed in might be a module that gets mapped to a fragment in the design
+        current_fragment = fragment
+        while current_fragment is not None:
+            # Check if this fragment directly contains the domain
+            if name in current_fragment.domains:
+                return current_fragment.domains[name]
+            
+            # Check parent fragment in hierarchy
+            if current_fragment in self.fragments:
+                frag_info = self.fragments[current_fragment]
+                current_fragment = frag_info.parent
+            else:
+                # If we can't find it in our design fragments, try to find it in the main fragment
+                if name in self.fragment.domains:
+                    return self.fragment.domains[name]
+                break
+        
+        # If we couldn't find it by walking up the hierarchy, check if it's a global domain
+        if name in self.fragment.domains:
+            return self.fragment.domains[name]
+        
+        # If still not found, it might be a standard domain like "sync"
+        # Check all fragments in the design
+        for frag, frag_info in self.fragments.items():
+            if name in frag.domains:
+                return frag.domains[name]
+        
+        # If we still haven't found it, raise an error
+        raise ValueError(f"Domain '{name}' not found in design")
+
 
