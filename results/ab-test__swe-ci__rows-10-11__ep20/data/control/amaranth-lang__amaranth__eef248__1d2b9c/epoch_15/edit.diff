+            # Check if the constructor expects a context parameter
+            import inspect
+            sig = inspect.signature(self.constructor)
+            if len(sig.parameters) > 0:
+                # If it expects parameters, pass the context
+                self.coroutine = self.constructor(ctx)
+            else:
+                # If it doesn't expect parameters, call it without context
