<?xml version="1.0" encoding="utf-8"?>
<requirement>
    <item>
        <location>/app/code/amaranth/sim/pysim.py</location>
        <description>The PySimEngine class has a broken implementation where methods like get_signal, set, get, posedge, changed, and delay return None instead of proper values or functionality, causing AttributeError exceptions in simulator tests.</description>
        <contract>
            <description>The get_signal method should return a valid signal state object that can be used by other methods. The set, get, posedge, changed, and delay methods should properly implement their respective functionality without returning None.</description>
            <behavior>
                <method name="get_signal">
                    <input>signal: Signal object</input>
                    <output>BaseSignalState object or integer index</output>
                    <exception>Should not raise AttributeError</exception>
                </method>
                <method name="set">
                    <input>signal: Signal object, value: integer</input>
                    <output>None</output>
                    <exception>Should not raise AttributeError</exception>
                </method>
                <method name="get">
                    <input>signal: Signal object</input>
                    <output>integer value</output>
                    <exception>Should not raise AttributeError</exception>
                </method>
                <method name="posedge">
                    <input>signal: Signal object</input>
                    <output>boolean or integer value</output>
                    <exception>Should not raise AttributeError</exception>
                </method>
                <method name="changed">
                    <input>signal: Signal object</input>
                    <output>boolean value</output>
                    <exception>Should not raise AttributeError</exception>
                </method>
                <method name="delay">
                    <input>duration: float or None</input>
                    <output>None</output>
                    <exception>Should not raise AttributeError</exception>
                </method>
            </behavior>
        </contract>
        <acceptance>
            <test>tests/test_sim.py::SimulatorRegressionTestCase::test_tick_repeat_until</test>
            <test>tests/test_sim.py::SimulatorRegressionTestCase::test_broken_other_trigger</test>
            <test>tests/test_sim.py::SimulatorRegressionTestCase::test_sample</test>
            <test>tests/test_sim.py::SimulatorRegressionTestCase::test_edge</test>
            <test>tests/test_sim.py::SimulatorRegressionTestCase::test_sync_reset</test>
            <test>tests/test_sim.py::SimulatorRegressionTestCase::test_trigger_wrong</test>
            <test>tests/test_sim.py::SimulatorRegressionTestCase::test_broken_multiedge</test>
            <test>tests/test_sim.py::SimulatorRegressionTestCase::test_critical</test>
            <test>tests/test_sim.py::SimulatorRegressionTestCase::test_struct</test>
            <test>tests/test_sim.py::SimulatorRegressionTestCase::test_latch</test>
            <test>tests/test_sim.py::SimulatorRegressionTestCase::test_delay</test>
            <test>tests/test_sim.py::SimulatorRegressionTestCase::test_abandon_delay</test>
            <test>tests/test_sim.py::SimulatorRegressionTestCase::test_timeout</test>
            <test>tests/test_sim.py::SimulatorRegressionTestCase::test_valuecastable</test>
            <test>tests/test_sim.py::SimulatorRegressionTestCase::test_async_reset</test>
            <test>tests/test_sim.py::SimulatorRegressionTestCase::test_abandon_changed</test>
        </acceptance>
    </item>
    <item>
        <location>/app/code/amaranth/hdl/_ir.py</location>
        <description>The lookup_domain method in the Design class fails to properly match ClockDomain objects, causing an assertion failure in DomainLookupTestCase where ClockDomain objects are not recognized as equivalent despite having the same properties.</description>
        <contract>
            <description>The lookup_domain method should correctly find and return ClockDomain objects by name from the fragment hierarchy, ensuring that domain objects with matching names are properly resolved regardless of their location in the hierarchy.</description>
            <behavior>
                <method name="lookup_domain">
                    <input>domain_name: string, fragment: Fragment object</input>
                    <output>ClockDomain object</output>
                    <exception>Should not raise AssertionError about object identity mismatch</exception>
                </method>
            </behavior>
        </contract>
        <acceptance>
            <test>tests/test_hdl_ir.py::DomainLookupTestCase::test_domain_lookup</test>
        </acceptance>
    </item>
    <item>
        <location>/app/code/amaranth/back/rtlil.py</location>
        <description>Memory-related tests fail due to improper implementation of memory handling in the RTLIL backend, particularly in how memory read/write operations are processed and handled in the RTLIL conversion process.</description>
        <contract>
            <description>The RTLIL backend memory handling should properly convert memory read and write operations from Amaranth IR to RTLIL format without throwing exceptions or returning incomplete data.</description>
            <behavior>
                <method name="convert_memory">
                    <input>memory: Memory object</input>
                    <output>RTLIL representation of memory operations</output>
                    <exception>Should not raise exceptions during memory read/write conversion</exception>
                </method>
            </behavior>
        </contract>
        <acceptance>
            <test>tests/test_back_rtlil.py::MemoryTestCase::test_async_read</test>
            <test>tests/test_back_rtlil.py::MemoryTestCase::test_sync_read</test>
        </acceptance>
    </item>
</requirement>