<requirements>
    <requirement>
        <location>/app/code/amaranth/hdl/_ir.py:426</location>
        <description>The Design.lookup_domain method is incomplete and raises TypeError when trying to iterate over a _ModuleBuilderDomainSet object that is not iterable.</description>
        <contract>
            <description>Fix the lookup_domain method to properly iterate through domain sets and handle the case where domains may not be directly accessible via iteration.</description>
            <behavior>
                <input>domain_name: str, fragment: Fragment</input>
                <output>ClockDomain object</output>
                <exception>KeyError when domain is not found</exception>
            </behavior>
        </contract>
        <acceptance>
            <test>tests/test_hdl_ir.py::DomainLookupTestCase::test_domain_lookup</test>
        </acceptance>
    </requirement>
