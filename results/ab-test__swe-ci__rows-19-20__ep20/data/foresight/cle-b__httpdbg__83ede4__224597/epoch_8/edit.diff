                     initiator, group, is_new = initiator_and_group
                     if is_new:
-                        # For exceptions, we should still create HTTP1Record by default
-                        # but we could enhance this in the future if needed
+                        # For exceptions, we should still create HTTP2Record by default
                         records.add_new_record_exception(
                             initiator, group, str(callargs["url"]), ex
                         )
