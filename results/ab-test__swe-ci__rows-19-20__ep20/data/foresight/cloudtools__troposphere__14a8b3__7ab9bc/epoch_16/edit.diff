+    def validate(self):
+        # Validate that Tags structure is correct for AnycastIpList
+        tags = self.properties.get("Tags")
+        if tags is not None:
+            # For AnycastIpList, tags must be a dict with exactly one key "Items"
+            if not isinstance(tags, dict):
+                raise ValueError("Tags property in AnycastIpList must be a dict")
+            
+            # Must have exactly one key: "Items"
+            if len(tags) != 1 or "Items" not in tags:
+                raise ValueError("Tags property in AnycastIpList must contain exactly one 'Items' key")
+            
+            # Items must be a list
+            items = tags["Items"]
+            if not isinstance(items, list):
+                raise ValueError("Tags property in AnycastIpList 'Items' must be a list")
+            
+            # All items in the list should be Tag objects or dicts with Key/Value fields
+            # This is more permissive than the original strict validation
+            for item in items:
+                if not isinstance(item, (Tag, dict)):
+                    raise ValueError("Tags property in AnycastIpList 'Items' must contain only Tag objects or dicts with Key/Value fields")
+                if isinstance(item, dict) and ("Key" not in item or "Value" not in item):
+                    raise ValueError("Tags property in AnycastIpList 'Items' must contain dicts with Key/Value fields")
