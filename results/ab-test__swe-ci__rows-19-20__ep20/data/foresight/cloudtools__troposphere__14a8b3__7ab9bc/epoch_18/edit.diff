+            from troposphere import Tag
+            # Tags must be a dict with required structure
+            if not isinstance(tags, dict):
+                raise ValueError("Tags property in AnycastIpList must be a dict")
+            
+            # Must have exactly one key: "Items"
+            if len(tags) != 1 or "Items" not in tags:
+                raise ValueError("Tags property in AnycastIpList must contain exactly one 'Items' key")
+            
+            # Items must be a list
+            items = tags["Items"]
+            if not isinstance(items, list):
+                raise ValueError("Tags property in AnycastIpList 'Items' must be a list")
+            
+            # All items in the list must be Tag objects
+            for item in items:
