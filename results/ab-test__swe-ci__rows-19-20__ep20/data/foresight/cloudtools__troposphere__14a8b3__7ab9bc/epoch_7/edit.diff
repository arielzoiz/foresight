@@ -19,7 +19,23 @@
     """
     Property: Distribution.Tags
     Property: StreamingDistribution.Tags
+    Property: AnycastIpList.Tags
     """
+    from . import tags_or_list
+    
+    # Special handling for AnycastIpList Tags which can be a dict with only "Items" key
+    if isinstance(x, dict) and "Items" in x and len(x) == 1:
+        items = x["Items"]
+        if isinstance(items, list):
+            # Validate each item in the Items list
+            for item in items:
+                if not isinstance(item, (dict, list)) or (isinstance(item, dict) and "Key" not in item):
+                    raise ValueError(f"Invalid tag structure in AnycastIpList Tags: {x}")
+            return x
+        else:
+            raise ValueError(f"Invalid tag structure in AnycastIpList Tags: {x}")
+    
+    # Fall back to standard validation for other cases
     return tags_or_list(x)
 
 
