+class MultiQueue:
+    """
+    Thread-safe queue with multiple output queues for concurrent processing.
+    """
+    
+    def __init__(self):
+        self._queues = []
+        self._lock = Lock()
+        
+    def put(self, item, queue_index=0):
+        """Put an item into a specific queue."""
+        with self._lock:
+            # Ensure we have enough queues
+            while len(self._queues) <= queue_index:
+                self._queues.append(deque())
+            
+            self._queues[queue_index].append(item)
+    
+    def get(self, queue_index=0):
+        """Get an item from a specific queue."""
+        with self._lock:
+            if len(self._queues) <= queue_index:
+                raise IndexError("Queue index out of range")
+            
+            if not self._queues[queue_index]:
+                raise IndexError("Queue is empty")
+                
+            return self._queues[queue_index].popleft()
+    
+    def empty(self, queue_index=0):
+        """Check if a specific queue is empty."""
+        with self._lock:
+            if len(self._queues) <= queue_index:
+                return True
+            return len(self._queues[queue_index]) == 0
+    
+    def qsize(self, queue_index=0):
+        """Get the size of a specific queue."""
+        with self._lock:
+            if len(self._queues) <= queue_index:
+                return 0
+            return len(self._queues[queue_index])
+    
+    def size(self):
+        """Get the total size of all queues."""
+        with self._lock:
+            return sum(len(q) for q in self._queues)
+    
+    def clear(self):
+        """Clear all queues."""
+        with self._lock:
+            self._queues.clear()
