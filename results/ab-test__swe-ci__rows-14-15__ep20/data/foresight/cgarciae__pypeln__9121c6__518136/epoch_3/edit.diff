@@ -0,0 +1,112 @@
+import typing
+from collections import deque
+from threading import Lock
+
+from pypeln import utils as pypeln_utils
+
+
+class Stage:
+    def __init__(
+        self,
+        f: typing.Callable,
+        workers: int,
+        maxsize: int,
+        on_start: typing.Callable,
+        on_done: typing.Callable,
+        dependencies: typing.List["Stage"],
+        worker_constructor: typing.Type = None,
+    ):
+
+        self.f = f
+        self.workers = workers
+        self.maxsize = maxsize
+        self.on_start = on_start
+        self.on_done = on_done
+        self.dependencies = dependencies
+        self.worker_constructor = worker_constructor
+
+        self.pipeline_namespace = pypeln_utils.Namespace()
+        self.pipeline_namespace.error = None
+
+    def __or__(self, stage):
+        return stage(self)
+
+    def __ror__(self, stage):
+        return self(stage)
+
+    def to_iterable(self, maxsize: int = 0):
+        # Simple synchronous processing for sync module
+        if self.dependencies:
+            # Get input from first dependency
+            dep = self.dependencies[0]
+            
+            # Get the input iterable
+            if hasattr(dep, 'to_iterable'):
+                input_iterable = dep.to_iterable(maxsize=maxsize)
+            else:
+                input_iterable = dep
+                
+            # Ensure input is iterable
+            if not hasattr(input_iterable, '__iter__') or isinstance(input_iterable, str):
+                input_iterable = [input_iterable]
+                
+            # Process each item
+            for item in input_iterable:
+                # Handle on_start callback
+                kwargs = {}
+                if self.on_start:
+                    # Try to detect if on_start expects worker_info
+                    try:
+                        import inspect
+                        sig = inspect.signature(self.on_start)
+                        if 'worker_info' in sig.parameters:
+                            # Create a simple worker info for sync
+                            from .utils import WorkerInfo
+                            worker_info = WorkerInfo(index=0)
+                            result_kwargs = self.on_start(worker_info)
+                        else:
+                            result_kwargs = self.on_start()
+                    except Exception:
+                        # Fallback to simple call
+                        result_kwargs = self.on_start()
+                    
+                    # Ensure result_kwargs is a dict (some on_start functions may return None)
+                    if result_kwargs is None:
+                        result_kwargs = {}
+                    kwargs = result_kwargs
+                
+                # Process the item
+                try:
+                    if self.f is not None:
+                        result = self.f(item, **kwargs)
+                        
+                        # Handle generator/iterable results (important for flat_map)
+                        if hasattr(result, '__iter__') and not isinstance(result, str):
+                            # Yield each item from the iterable
+                            for item in result:
+                                yield item
+                        else:
+                            # Yield single item
+                            yield result
+                    else:
+                        # For concat-like operations, yield the item directly
+                        yield item
+                        
+                except Exception as e:
+                    self.pipeline_namespace.error = e
+                    raise
+                finally:
+                    # Handle on_done callback
+                    if self.on_done:
+                        try:
+                            self.on_done(**kwargs)
+                        except:
+                            pass
+        else:
+            # Direct iterable for from_iterable
+            if hasattr(self, 'iterable'):
+                for item in self.iterable:
+                    yield item
+
+    def __iter__(self):
+        return iter(self.to_iterable())
