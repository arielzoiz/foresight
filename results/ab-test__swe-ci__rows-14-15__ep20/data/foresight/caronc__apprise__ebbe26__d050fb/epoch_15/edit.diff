+        # Handle the case where we have results that are not boolean values
+        # or None (which would cause all() to fail)
+        processed_results = []
+        for result in results:
+            if isinstance(result, bool):
+                processed_results.append(result)
+            elif result is None:
+                # None means no notification was sent, which should be treated as success
+                processed_results.append(True)
+            elif isinstance(result, Exception):
+                # Exception should be treated as failure
+                processed_results.append(False)
+            else:
+                # For any other result, treat as success (shouldn't normally happen)
+                processed_results.append(True)
+                
+        return all(processed_results)
 
