+    """
+    Creates a namespace object that can be used to share data between workers.
+    
+    Returns:
+        A namespace object that can be used to store and retrieve data.
+    """
+    # For synchronous operations, we use threading to manage namespaces
+    # This is simpler than multiprocessing for sync operations
+    import threading
+    
+    # Create a thread-local namespace to avoid conflicts
+    thread_local = threading.local()
+    
+    if not hasattr(thread_local, 'namespace'):
+        thread_local.namespace = type('Namespace', (), {})()
+        
+    return thread_local.namespace
 
 
