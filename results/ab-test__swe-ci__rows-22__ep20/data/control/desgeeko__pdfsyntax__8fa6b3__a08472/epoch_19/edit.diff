+"""Module pdfsyntax.objects: Parser"""
+
+import re
+import zlib
+from collections import namedtuple
+
+EOL = b'\r\n'
+SPACE = EOL + b'\x00\x09\x0c\x20'
+
+from .text import text_string
+
+def skip_chars(chars, text, i):
+    """ syntax
+    """
+    while i < len(text):
+        if text[i] not in chars: return i
+        i += 1
+    return None        
+
+
+def next_token(text, i=0):
+    """ syntax Find next token in raw string starting at some index
+    """
+    search = "TBD"
+    nested = 1
+    h = i
+    while i < len(text):
+        single = text[i:i+1]
+        double = text[i:i+2]
+        if search == "TBD":
+            if double == b'<<':
+                search = "DICT"
+                h = i
+                i += 1
+            elif single == b'[':
+                search = "ARRAY"
+                h = i
+            elif single == b"/":
+                search = "NAME"
+                h = i
+            elif text[i:i+6] == b"stream":
+                search = "STREAM"
+                # Skip past "stream" and any following whitespace/newline
+                i += 6
+                # Skip any whitespace or newlines after "stream"
+                while i < len(text) and text[i:i+1] in b"\r\n \t":
+                    i += 1
+                h = i
+            elif single in b"+-.0123456789":
+                search = "VALUE"
+                h = i
+            elif single in b"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ":
+                search = "KEYWORD"
+                h = i
+            elif single in b"(":
+                search = "TEXT"
+                h = i
+            elif single in b"<":
+                search = "HEX_STRING"
+                h = i
+            elif single == b"%":
+                search = "COMMENT"
+                h = i
+            elif single in b" \n\r\t\f":
+                i += 1
+                h = i
+                continue
+            else:
+                return (h, i + 1, 'UNKNOWN')
+        elif search == "DICT":
+            if double == b'<<':
+                nested += 1
+                i += 1
+            elif double == b'>>':
+                nested -= 1
+                i += 1
+            if nested == 0:
+                return (h, i + 1, 'DICT')
+            elif i == len(text):  # Incomplete DICT at end of input
+                return (h, i, 'DICT')
+        elif search == "NAME":
+            if single in b' \n\r[]/<>(':
+                return (h, i, 'NAME')
+            elif i == len(text):  # Incomplete NAME at end of input
+                return (h, i, None)
+        elif search == "VALUE":
+            if single in b' \n\r>/]':
+                # Determine if it's INTEGER or REAL
+                value = text[h:i]
+                if b'.' in value or b'e' in value.lower():
+                    return (h, i, 'REAL')
+                else:
+                    return (h, i, 'INTEGER')
+            elif i == len(text):  # Incomplete VALUE at end of input
+                # For incomplete values, return None as token type (as per test expectation)
+                return (h, i, None)
+            elif i == len(text):  # Incomplete VALUE at end of input
+                # For incomplete values, return None as token type (as per test expectation)
+                return (h, i, None)
+        i += 1
+        # Handle end-of-input conditions after incrementing
+        if i == len(text):
+            # Handle incomplete tokens at end of text
+            if search == "TBD":
+                return (h, i, None)
+            elif search == "VALUE":
+                # For incomplete values, return None as token type (as per test expectation)
+                return (h, i, None)
+            elif search == "NAME":
+                return (h, i, None)
+            elif search == "TEXT":
+                return (h, i, 'STRING')
+            elif search == "HEX_STRING":
+                return (h, i, 'STRING')
+            elif search == "KEYWORD":
+                return (h, i, 'KEYWORD')
+            elif search == "COMMENT":
+                return (h, i, 'COMMENT')
+            elif search == "ARRAY":
+                return (h, i, 'ARRAY')
+            elif search == "DICT":
+                return (h, i, 'DICT')
+            elif search == "STREAM":
+                return (h, i, 'STREAM')
+    # Handle incomplete tokens at end of text
+    if search == "TBD":
+        return (h, i, None)
+    elif search == "VALUE":
+        # For incomplete values, return None as token type (as per test expectation)
+        return (h, i, None)
+    elif search == "NAME":
+        return (h, i, 'NAME')
+    elif search == "TEXT":
+        return (h, i, 'STRING')
+    elif search == "HEX_STRING":
+        return (h, i, 'STRING')
+    elif search == "KEYWORD":
+        return (h, i, 'KEYWORD')
+    elif search == "COMMENT":
+        return (h, i, 'COMMENT')
+    elif search == "ARRAY":
+        return (h, i, 'ARRAY')
+    elif search == "DICT":
+        return (h, i, 'DICT')
+    elif search == "STREAM":
+        return (h, i, 'STREAM')
+    return (h, i, None)
+
+
+def replace_ref(tokens):
+    """ syntax
+    """
+    size = len(tokens)
+    new_list = []
+    i = 0
+    while i < size:
+        # Check if we have an integer followed by '0' and then 'R' 
+        # This handles the pattern like [2, 0, 'R'] or [6, 0, 'R'] or [b'2', b'0', b'R']
+        if (i < size - 2 and 
+            isinstance(tokens[i], (int, str, bytes)) and 
+            (isinstance(tokens[i+1], (int, bytes)) and tokens[i+1] == 0) and
+            (isinstance(tokens[i+2], (str, bytes)) and tokens[i+2] in [b'R', 'R'])):
+            # Convert to complex number representation for reference
+            try:
+                if isinstance(tokens[i], bytes):
+                    num = int(tokens[i])
+                elif isinstance(tokens[i], str):
+                    num = int(tokens[i])
+                else:
+                    num = tokens[i]
+                new_list.append(complex(0, num))
+            except ValueError:
+                new_list.append(tokens[i])
+            i += 3
+        else:
+            new_list.append(tokens[i])
+            i += 1
+    return new_list
+
+def decode_predictor(bdata, predictor, columns):
+    size = len(bdata)
+    res = b''
+    columns += 1
+    prev_row = [0] * columns
+    i = 0
+    while i < size:
+        row = list(bdata[i:i+columns])
+        decoded_row = [(val + prev_row[index]) & 0xff for (index, val) in enumerate(row)]
+        prev_row = decoded_row
+        res += bytes(decoded_row[1:])
+        i += columns
+    return res
+
+
+def decode_stream(stream, stream_def):
+    res = stream
+    if b'/Filter' in stream_def and stream_def[b'/Filter'] == b'/FlateDecode':
+        res = zlib.decompress(stream) #+ b'\r')
+    if b'/DecodeParms' in stream_def and b'/Predictor' in stream_def[b'/DecodeParms']:
+        predictor = int(stream_def[b'/DecodeParms'][b'/Predictor'])
+        columns = int(stream_def[b'/DecodeParms'][b'/Columns'])
+        res = decode_predictor(res, predictor, columns)
+    return res
+
+
+def parse_obj(text, start=0):
+    """ syntax
+    """
+    h1, j1, t1 = next_token(text, start)
+    if t1 == 'DICT':
+        res = {}
+        i = h1 + 2  # Skip << 
+        while i < j1 - 2:  # Skip >>
+            # Skip whitespace
+            i = skip_chars(SPACE, text, i)
+            if i is None or i >= j1 - 2:
+                break
+                
+            # Parse key
+            h_key, i_key, t_key = next_token(text, i)
+            if t_key != 'NAME':
+                # If not a name, skip it
+                i = i_key
+                continue
+                
+            key = text[h_key:i_key].decode('utf-8')
+            
+            # Skip whitespace
+            i = skip_chars(SPACE, text, i_key)
+            if i is None or i >= j1 - 2:
+                break
+                
+            # Parse value
+            h_val, i_val, t_val = next_token(text, i)
+            if t_val == 'DICT' or t_val == 'ARRAY':
+                val = parse_obj(text, h_val)
+            elif t_val == 'NAME':
+                val = text[h_val:i_val].decode('utf-8')
+            elif t_val == 'STRING':
+                val = text_string(text[h_val:i_val])
+            elif t_val == 'INTEGER' or t_val == 'REAL':
+                val = text[h_val:i_val]
+                try:
+                    val = float(val) if b'.' in val else int(val)
+                except ValueError:
+                    pass
+            elif t_val == 'TRUE':
+                val = True
+            elif t_val == 'FALSE':
+                val = False
+            elif t_val == 'KEYWORD':
+                val = text[h_val:i_val].decode('utf-8')
+                # Special case for boolean keywords
+                if val == b'true':
+                    val = True
+                elif val == b'false':
+                    val = False
+            elif t_val == 'COMMENT':
+                # Skip comments completely and continue parsing
+                i = i_val
+                continue
+            else:
+                val = text[h_val:i_val].decode('utf-8')
+                
+            # Check if this is a reference pattern (integer 0 R) - for dict values
+            if t_val == 'INTEGER' and i_val < len(text):
+                # Look ahead to see if it's followed by 0 R
+                temp_i = i_val
+                # Skip whitespace
+                temp_i = skip_chars(SPACE, text, temp_i)
+                if temp_i is not None and temp_i < len(text):
+                    h0, i0, t0 = next_token(text, temp_i)
+                    if t0 == 'INTEGER' and text[h0:i0] == b'0':
+                        # Check for R keyword
+                        temp_i = i0
+                        temp_i = skip_chars(SPACE, text, temp_i)
+                        if temp_i is not None and temp_i < len(text):
+                            hR, iR, tR = next_token(text, temp_i)
+                            if tR == 'KEYWORD' and text[hR:iR] == b'R':
+                                # This is a reference
+                                try:
+                                    num = int(text[h_val:i_val])
+                                    val = complex(0, num)  # Format as 0 + num*j = num*j
+                                except ValueError:
+                                    pass
+            res[key] = val
+            i = i_val
+            
+        return res
+
+    elif t1 == 'ARRAY':
+        res = []
+        i = h1 + 1  # Skip [
+        while i < j1 - 1:  # Skip ]
+            # Skip whitespace
+            i = skip_chars(SPACE, text, i)
+            if i is None or i >= j1 - 1:
+                break
+                
+            h, i, ttt = next_token(text, i)
+            if ttt == 'DICT' or ttt == 'ARRAY':
+                obj = parse_obj(text, h)
+            elif ttt == 'NAME':
+                obj = text[h:i].decode('utf-8')
+            elif ttt == 'STRING':
+                obj = text_string(text[h:i])
+            elif ttt == 'INTEGER' or ttt == 'REAL':
+                obj = text[h:i]
+                try:
+                    obj = float(obj) if b'.' in obj else int(obj)
+                except ValueError:
+                    obj = obj.decode('utf-8')
+            elif ttt == 'TRUE':
+                obj = True
+            elif ttt == 'FALSE':
+                obj = False
+            elif ttt == 'KEYWORD':
+                obj = text[h:i].decode('utf-8')
+                # Special case for boolean keywords
+                if obj == b'true':
+                    obj = True
+                elif obj == b'false':
+                    obj = False
+            elif ttt == 'COMMENT':
+                # Skip comments completely and continue parsing
+                # Find the end of the comment (next newline or end of text)
+                while i < len(text) and text[i:i+1] not in b'\r\n':
+                    i += 1
+                # Skip past the newline
+                if i < len(text) and text[i:i+1] in b'\r\n':
+                    i += 1
+                continue
+            else:
+                obj = text[h:i].decode('utf-8')
+            res.append(obj)
+        
+        # Process references properly - check if we have integer 0 R pattern in the array
+        processed_res = []
+        i = 0
+        while i < len(res):
+            # Check if we have three consecutive elements that form a reference pattern
+            if (i + 2 < len(res) and 
+                isinstance(res[i], (int, float)) and 
+                isinstance(res[i+1], int) and res[i+1] == 0 and 
+                isinstance(res[i+2], str) and res[i+2] == 'R'):
+                # Convert to complex number representation for reference
+                processed_res.append(complex(0, res[i]))  # Format as 0 + num*j = num*j
+                i += 3
+            else:
+                processed_res.append(res[i])
+                i += 1
+        return processed_res
+    else:
+        # For simple objects that aren't arrays or dicts, check if it's a reference
+        # We need to handle references that appear alone (not in arrays)
+        h, i, t = next_token(text, start)
+        if t == 'INTEGER' and i < len(text):
+            # Check if next token is '0' and then 'R'
+            h2, i2, t2 = next_token(text, i)
+            if t2 == 'INTEGER' and text[h2:i2] == b'0':
+                h3, i3, t3 = next_token(text, i2)
+                if t3 == 'KEYWORD' and text[h3:i3] == b'R':
+                    # This is a reference: integer 0 R
+                    try:
+                        num = int(text[h:i])
+                        return complex(0, num)  # Format as 0 + num*j = num*j
+                    except ValueError:
+                        return None
+        # For other cases, return the parsed object normally
+        if t == 'DICT' or t == 'ARRAY':
+            return parse_obj(text, h)
+        elif t == 'NAME':
+            return text[h:i].decode('utf-8')
+        elif t == 'STRING':
+            return text_string(text[h:i])
+        elif t == 'INTEGER' or t == 'REAL':
+            val = text[h:i]
+            try:
+                val = float(val) if b'.' in val else int(val)
+            except ValueError:
+                pass
+            return val
+        elif t == 'TRUE':
+            return True
+        elif t == 'FALSE':
+            return False
+        elif t == 'KEYWORD':
+            val = text[h:i].decode('utf-8')
+            # Special case for boolean keywords
+            if val == 'true':
+                return True
+            elif val == 'false':
+                return False
+            return val
+        else:
+            return text[h:i].decode('utf-8')
+
+
+def beginning_next_non_empty_line(bdata, i):
+    """ doc
+    """
+    while bdata[i] not in EOL:
+        i += 1
+    while bdata[i] in EOL:
+        i += 1
+    return i
+
+
