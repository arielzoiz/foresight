+def serialize(obj):
+    """Convert Python data structures to PDF syntax format."""
+    if isinstance(obj, dict):
+        items = []
+        for k, v in obj.items():
+            items.append(k)
+            items.append(serialize(v))
+        return b'<< ' + b' '.join(items) + b' >>'
+    elif isinstance(obj, list):
+        items = []
+        for item in obj:
+            items.append(serialize(item))
+        return b'[' + b' '.join(items) + b']'
+    elif isinstance(obj, str):
+        return b'(' + obj.encode('utf-8') + b')'
+    elif isinstance(obj, bool):
+        return b'true' if obj else b'false'
+    elif isinstance(obj, int) or isinstance(obj, float):
+        return str(obj).encode('ascii')
+    elif isinstance(obj, complex):
+        # Handle reference objects (like 6j)
+        return str(int(obj.real)).encode('ascii') + b' 0 R'
+    else:
+        return str(obj).encode('ascii')
