+def text_string(text):
+    """Process PDF text strings (literal and hexadecimal formats) and convert to Python strings."""
+    if text.startswith(b'('):
+        # Literal string
+        result = text[1:-1]  # Remove parentheses
+        # Handle escape sequences
+        result = result.replace(b'\\(', b'(')
+        result = result.replace(b'\\)', b')')
+        result = result.replace(b'\\n', b'\n')
+        result = result.replace(b'\\r', b'\r')
+        result = result.replace(b'\\t', b'\t')
+        result = result.replace(b'\\b', b'\b')
+        result = result.replace(b'\\f', b'\f')
+        result = result.replace(b'\\\\', b'\\')
+        # Handle octal escape sequences
+        # This is a simplified version - in practice, more complex parsing would be needed
+        return result.decode('latin1')  # Simple decoding for now
+    elif text.startswith(b'<'):
+        # Hexadecimal string
+        hex_str = text[1:-1].decode('ascii').replace(' ', '')  # Remove angle brackets and spaces
+        # Convert hex to bytes
+        byte_data = bytes.fromhex(hex_str)
+        # Try UTF-16BE decoding first (common for PDF)
+        try:
+            return byte_data.decode('utf-16-be')
+        except UnicodeDecodeError:
+            # Fall back to Latin-1
+            return byte_data.decode('latin1')
+    else:
+        return text.decode('latin1')
+
