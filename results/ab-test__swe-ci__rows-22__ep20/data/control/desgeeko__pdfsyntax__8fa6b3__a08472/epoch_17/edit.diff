@@ -0,0 +1,29 @@
+#!/usr/bin/env python3
+
+import sys
+sys.path.insert(0, '/app/code')
+
+from pdfsyntax.objects import next_token, parse_obj
+from pdfsyntax.text import text_string
+
+# Test the comment handling in arrays
+print("Testing comment handling in arrays...")
+result = parse_obj(b'[%a\n/abc %b %c \n 123%d\n]')
+print(f"Result: {result}")
+expected = ['/abc', 123]
+print(f"Expected: {expected}")
+print(f"Match: {result == expected}")
+
+# Test stream parsing
+print("\nTesting stream parsing...")
+result = next_token(b'stream\n xyz \nendstream ', 0)
+print(f"Stream token result: {result}")
+
+# Test UTF-16BE decoding
+print("\nTesting UTF-16BE decoding...")
+test_string = b'(\xfe\xff\x00M\x00a\x00r\x00t\x00i\x00n\x00 \x00D\x00.)'
+result = text_string(test_string)
+print(f"Decoded string: '{result}'")
+expected = 'Martin D.'
+print(f"Expected: '{expected}'")
+print(f"Match: {result == expected}")
