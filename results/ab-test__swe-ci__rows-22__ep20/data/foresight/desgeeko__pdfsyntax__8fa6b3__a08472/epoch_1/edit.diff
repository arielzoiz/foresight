+def serialize(obj):
+    """ Serialize Python object to PDF syntax byte string """
+    if isinstance(obj, dict):
+        items = []
+        for k, v in obj.items():
+            items.append(serialize(k))
+            items.append(serialize(v))
+        return b'<< ' + b' '.join(items) + b' >>'
+    elif isinstance(obj, list):
+        items = [serialize(item) for item in obj]
+        return b'[' + b' '.join(items) + b']'
+    elif isinstance(obj, bool):
+        return b'true' if obj else b'false'
+    elif isinstance(obj, int) or isinstance(obj, float):
+        return str(obj).encode('ascii')
+    elif isinstance(obj, str):
+        # Handle string serialization (for names and literals)
+        if obj.startswith('/'):
+            return obj.encode('ascii')
+        else:
+            # For literal strings, we need to encode them properly
+            return b'(' + obj.encode('utf-8') + b')'
+    elif isinstance(obj, bytes):
+        return obj
+    else:
+        # Default to string representation
+        return str(obj).encode('ascii')
 
