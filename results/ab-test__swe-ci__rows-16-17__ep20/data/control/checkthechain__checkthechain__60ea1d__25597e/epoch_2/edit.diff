+def standardize_transaction(transaction: spec.Transaction) -> spec.Transaction:
+    """Standardize transaction format according to Ethereum specifications."""
+    # Ensure all standard fields are present and properly formatted
+    standardized = transaction.copy()
+    
+    # Convert common fields to consistent format
+    if 'chain_id' in standardized:
+        standardized['chainId'] = standardized.pop('chain_id')
+        
+    if 'max_fee_per_gas' in standardized:
+        standardized['maxFeePerGas'] = standardized.pop('max_fee_per_gas')
+        
+    if 'max_priority_fee_per_gas' in standardized:
+        standardized['maxPriorityFeePerGas'] = standardized.pop('max_priority_fee_per_gas')
+        
+    if 'access_list' in standardized:
+        standardized['accessList'] = standardized.pop('access_list')
+        
+    if 'type' in standardized:
+        standardized['type'] = standardized['type']
+        
+    # Handle data field
+    if 'data' in standardized:
+        # Ensure data is properly formatted (should be hex string with 0x prefix)
+        data = standardized['data']
+        if isinstance(data, bytes):
+            standardized['data'] = '0x' + data.hex()
+        elif isinstance(data, str) and not data.startswith('0x'):
+            standardized['data'] = '0x' + data
+        # If already hex string, leave as is
+        
+    # Handle gas price fields - ensure consistency for both legacy and EIP-1559 transactions
+    if 'gas_price' in standardized:
+        standardized['gasPrice'] = standardized.pop('gas_price')
+    elif 'gasPrice' in standardized:
+        # If gasPrice already exists, ensure it's an integer
+        if not isinstance(standardized['gasPrice'], int):
+            standardized['gasPrice'] = int(standardized['gasPrice'])
+    
+    # Handle EIP-1559 specific fields properly
+    if 'maxFeePerGas' in standardized and 'maxPriorityFeePerGas' in standardized:
+        # Ensure they are integers
+        if not isinstance(standardized['maxFeePerGas'], int):
+            standardized['maxFeePerGas'] = int(standardized['maxFeePerGas'])
+        if not isinstance(standardized['maxPriorityFeePerGas'], int):
+            standardized['maxPriorityFeePerGas'] = int(standardized['maxPriorityFeePerGas'])
+        
+    return standardized
+
+
+def sign_transaction(
+    transaction: spec.UnsignedTransaction,
+    *,
+    private_key: str,
+    chain_id: int | None = None,
+) -> tuple[int, int, int]:
+    """Sign a transaction with the provided private key."""
+    from ctc.binary.signatures.transaction_signatures import sign_transaction as _sign_transaction
+    return _sign_transaction(transaction, private_key=private_key, chain_id=chain_id)
