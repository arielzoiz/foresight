+from __future__ import annotations
+
+import hashlib
+import json
+
+from ctc import spec
+from .. import formats
+from .. import hashes
+
+
+def get_domain_separator(domain: spec.Domain) -> str:
+    """Generate the domain separator for EIP-712 typed data signatures."""
+    # Create the domain hash using the EIP-712 specification
+    domain_data = {
+        "name": domain.get("name", ""),
+        "version": domain.get("version", ""),
+        "chainId": domain.get("chainId", 0),
+        "verifyingContract": domain.get("verifyingContract", ""),
+    }
+    
+    # Ensure proper sorting and formatting as per EIP-712
+    domain_json = json.dumps(
+        domain_data,
+        sort_keys=True,
+        separators=(',', ':'),
+        ensure_ascii=False
+    ).encode('utf-8')
+    
+    domain_hash = hashes.keccak(domain_json, output_format='binary')
+    
+    # Prepend the EIP-712 domain separator prefix
+    domain_separator = b'\x19\x01' + domain_hash
+    
+    return formats.convert(domain_separator, 'prefix_hex')
