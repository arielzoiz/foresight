+def verify_transaction_signature(
+    *,
+    transaction: spec.Transaction,
+    signature: spec.VRS,
+    address: spec.Address | None = None,
+) -> bool:
+    """Verify a transaction signature against the transaction data.
+    
+    Args:
+        transaction: Transaction dictionary
+        signature: VRS signature tuple (v, r, s) or hex string
+        address: Expected signer address (optional)
+        
+    Returns:
+        Boolean indicating if signature is valid
+    """
+    # Extract v, r, s from signature
+    if isinstance(signature, str):
+        v, r, s = vrs_utils.unpack_vrs(signature)
+    else:
+        v, r, s = signature
+    
+    # Get transaction hash
+    from ctc.binary.signatures.transaction_signatures import get_transaction_hash
+    transaction_hash = get_transaction_hash(transaction)
+    
+    # Convert transaction hash to bytes for recovery
+    message_hash = hashes.keccak(transaction_hash)
+    
+    # Recover public key
+    public_key = signature_recovery.get_signer_public_key(
+        message_hash=message_hash,
+        v=v,
+        r=r,
+        s=s,
+    )
+    
+    # Convert public key to address
+    recovered_address = '0x' + hashes.keccak(public_key)[-40:]
+    
+    # If address is provided, verify it matches
+    if address is not None:
+        return recovered_address.lower() == address.lower()
+    
+    # Otherwise just return that the signature is valid
+    return True
