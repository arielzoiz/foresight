+def public_key_tuple_to_hex(public_key_tuple: tuple[int, int]) -> spec.PrefixHexData:
+    """Convert a public key tuple to hexadecimal string representation."""
+    x, y = public_key_tuple
+    
+    # Convert to hex and pad to 64 characters (32 bytes each)
+    x_hex = format(x, '064x')
+    y_hex = format(y, '064x')
+    
+    # Combine into uncompressed public key format (04 + x + y)
+    public_key_hex = '04' + x_hex + y_hex
+    return '0x' + public_key_hex
+
