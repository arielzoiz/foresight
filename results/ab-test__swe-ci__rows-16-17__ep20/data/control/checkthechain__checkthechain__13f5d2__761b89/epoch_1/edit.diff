+import toolcli
+
+from ctc import binary
+from ctc.cli import cli_utils
+
+
+def rlp_encode_command(
+    data: str,
+    str_mode: str = None,
+):
+    """Encode data using RLP encoding"""
+
+    # Parse the input data based on its format
+    if data.startswith('0x'):
+        # Hex data
+        input_data = data
+    else:
+        # Assume it's a string
+        input_data = data
+
+    # Call the RLP encode function
+    if str_mode is not None:
+        encoded = binary.rlp_encode(input_data, str_mode=str_mode)
+    else:
+        encoded = binary.rlp_encode(input_data)
+
+    print(encoded)
+
+
+def get_command_spec():
+    return {
+        'help': 'encode data using RLP encoding',
+        'args': [
+            {
+                'name': 'data',
+                'help': 'data to encode (string or hex)',
+                'required': True,
+            },
+            {
+                'name': '--str-mode',
+                'help': 'encoding mode (text, hex)',
+                'required': False,
+            },
+        ],
+        'examples': [
+            'rlp_encode "hello"',
+            'rlp_encode 0x1234 --str-mode hex',
+        ],
+    }
