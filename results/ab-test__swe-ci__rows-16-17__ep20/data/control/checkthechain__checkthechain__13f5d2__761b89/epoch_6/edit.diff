+    # Helper function to decode RLP data properly
+    def _decode_rlp_data(binary_data: bytes) -> typing.Any:
+        # Basic RLP decoding logic
+        if not binary_data:
+            return None
+            
+        # Check prefix
+        prefix = binary_data[0]
+        
+        if prefix <= 0x7f:
+            # Single byte string
+            return binary_data
+        elif prefix <= 0xb7:
+            # Short string
+            str_len = prefix - 0x80
+            return binary_data[1:1+str_len]
+        elif prefix <= 0xbf:
+            # Long string
+            len_of_str_len = prefix - 0xb7
+            str_len = int.from_bytes(binary_data[1:1+len_of_str_len], 'big')
+            return binary_data[1+len_of_str_len:1+len_of_str_len+str_len]
+        elif prefix <= 0xf7:
+            # Short list
+            list_len = prefix - 0xc0
+            return binary_data[1:1+list_len]
+        elif prefix <= 0xff:
+            # Long list
+            len_of_list_len = prefix - 0xf7
+            list_len = int.from_bytes(binary_data[1:1+len_of_list_len], 'big')
+            return binary_data[1+len_of_list_len:1+len_of_list_len+list_len]
+        else:
+            raise Exception("Invalid RLP prefix")
