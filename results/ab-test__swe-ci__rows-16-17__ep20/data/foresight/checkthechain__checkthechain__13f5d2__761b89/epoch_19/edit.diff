+    elif isinstance(data, bytes):
+        # Bytes encoding
+        if len(data) == 1 and data[0] < 0x80:
+            # Single byte data less than 0x80 - encode as-is
+            return formats.convert(data, 'prefix_hex')
+        else:
+            # Long string - encode length + data
+            data_len = len(data)
+            if data_len < 56:
+                # Short string
+                prefix = 0x80 + data_len
+                return formats.convert(prefix, 'prefix_hex') + formats.convert(data, 'raw_hex')
+            else:
+                # Long string
+                data_len_bytes = (data_len.bit_length() + 7) // 8
+                prefix = 0xb7 + data_len_bytes
+                length_prefix = formats.convert(data_len_bytes, 'prefix_hex')
+                return formats.convert(prefix, 'prefix_hex') + length_prefix + formats.convert(data, 'raw_hex')
