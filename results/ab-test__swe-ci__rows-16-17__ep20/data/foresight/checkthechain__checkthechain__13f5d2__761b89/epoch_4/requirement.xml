  <requirement>
    <location>/app/code/src/ctc/binary/rlp_coding.py</location>
    <description>The rlp_encode function has several issues with string handling and hex validation that cause "non-hexadecimal number found in fromhex() arg" errors when processing hex strings.</description>
    <contract>
      <description>The rlp_encode function must properly handle hex strings with and without '0x' prefixes, validate hex strings correctly, and produce correct RLP encodings for various data types.</description>
      <behavior>
        <input>Accepts strings with or without '0x' prefix, integers, and lists</input>
        <output>RLP-encoded hex string with '0x' prefix</output>
        <validation>Must validate hex strings properly using bytes.fromhex()</validation>
        <error_handling>Should raise ValueError for invalid hex strings</error_handling>
      </behavior>
    </contract>
    <acceptance>
