+def get_created_address(
+    sender: str, 
+    salt: str = None, 
+    init_code: str = None, 
+    nonce: int = None
+) -> str:
+    """
+    Derive Ethereum address for CREATE or CREATE2 operations
+    
+    For CREATE2:
+    - sender: address that initiates the creation
+    - salt: 32-byte salt for CREATE2
+    - init_code: initialization code for CREATE2
+    
+    For CREATE:
+    - sender: address that initiates the creation
+    - nonce: transaction nonce for CREATE
+    """
+    # Remove '0x' prefix if present from sender
+    if sender.startswith('0x'):
+        sender = sender[2:]
+    
+    # Handle CREATE2 case
+    if salt is not None and init_code is not None:
+        # Remove '0x' prefix if present from salt and init_code
+        if salt.startswith('0x'):
+            salt = salt[2:]
+        if init_code.startswith('0x'):
+            init_code = init_code[2:]
+            
+        # Perform CREATE2 address derivation
+        import hashlib
+        # Keccak256(0xff + sender + salt + keccak256(init_code))
+        prefix = b'\xff'
+        data = prefix + bytes.fromhex(sender) + bytes.fromhex(salt) + hashlib.keccak_256(bytes.fromhex(init_code)).digest()
+        address = hashlib.keccak_256(data).digest()[-20:]
+        return '0x' + address.hex()
+    
+    # Handle CREATE case
+    elif nonce is not None:
+        # Perform CREATE address derivation
+        import rlp
+        import hashlib
+        
+        # RLP encode [sender, nonce]
+        rlp_encoded = rlp.encode([bytes.fromhex(sender), nonce])
+        # Keccak256 of RLP encoded data
+        address = hashlib.keccak_256(rlp_encoded).digest()[-20:]
+        return '0x' + address.hex()
+    
+    else:
+        raise ValueError('Either salt and init_code (for CREATE2) or nonce (for CREATE) must be provided')
+
