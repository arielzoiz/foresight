+from __future__ import annotations
+
+import toolcli
+
+from ctc import binary
+
+
+def get_command_spec() -> toolcli.CommandSpec:
+    return {
+        'f': rlp_encode_command,
+        'help': 'encode data using RLP encoding',
+        'args': [
+            {
+                'name': 'data',
+                'help': 'data to encode (string, integer, or list)',
+            },
+            {
+                'name': '--str-mode',
+                'help': 'mode for string encoding (text or hex)',
+                'default': 'text',
+            },
+        ],
+        'examples': [
+            '0x1234',
+            'hello',
+            '[1, 2, 3]',
+        ],
+    }
+
+
+def rlp_encode_command(data: str, str_mode: str) -> None:
+    # Parse the data as appropriate
+    import json
+    
+    try:
+        # Try to parse as JSON first (for lists, etc.)
+        parsed_data = json.loads(data)
+    except json.JSONDecodeError:
+        # Treat as plain string
+        parsed_data = data
+        
+    output = binary.rlp_encode(parsed_data, str_mode=str_mode)
+    print(output)
