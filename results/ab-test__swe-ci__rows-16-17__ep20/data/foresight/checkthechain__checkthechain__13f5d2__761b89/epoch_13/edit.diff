 from ctc import spec
 
 
+def get_binary_format(data: spec.BinaryData) -> spec.BinaryFormat:
+    """Get the format of binary data"""
+    if isinstance(data, str):
+        if data.startswith('0x'):
+            return 'prefix_hex'
+        else:
+            return 'raw_hex'
+    elif isinstance(data, bytes):
+        return 'binary'
+    elif isinstance(data, int):
+        return 'integer'
+    else:
+        raise ValueError(f"Unknown data type: {type(data)}")
+
+
+def get_binary_n_bytes(data: spec.BinaryData) -> int:
+    """Get the number of bytes in binary data"""
+    if isinstance(data, str):
+        if data.startswith('0x'):
+            return len(data[2:]) // 2
+        else:
+            return len(data) // 2
+    elif isinstance(data, bytes):
+        return len(data)
+    elif isinstance(data, int):
+        return (data.bit_length() + 7) // 8
+    else:
+        raise ValueError(f"Unknown data type: {type(data)}")
+
+
+def match_format(format_this: spec.BinaryData, like_this: spec.BinaryData) -> spec.BinaryData:
+    """Match the format of format_this to like_this"""
+    target_format = get_binary_format(like_this)
+    return convert(format_this, target_format)
+
+
