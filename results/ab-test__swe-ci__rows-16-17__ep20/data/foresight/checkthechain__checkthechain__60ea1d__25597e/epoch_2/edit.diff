     from typing_extensions import Literal
 
 
+def get_domain_separator(domain: dict[str, typing.Any]) -> str:
+    """Compute the EIP-712 domain separator from a domain dictionary"""
+    # Create the domain struct hash
+    domain_struct = [
+        ('name', 'string'),
+        ('version', 'string'),
+        ('chainId', 'uint256'),
+        ('verifyingContract', 'address'),
+    ]
+    
+    # Build the domain data in the correct order
+    domain_data = []
+    for field_name, field_type in domain_struct:
+        if field_name in domain:
+            field_value = domain[field_name]
+            if field_type == 'string':
+                # For strings, we need to keccak hash the string
+                field_data = hashes.keccak_text(field_value, output_format='binary')
+                domain_data.append(field_data)
+            elif field_type == 'uint256':
+                # For uint256, convert to bytes
+                field_data = formats.convert(field_value, 'bytes32')
+                domain_data.append(field_data)
+            elif field_type == 'address':
+                # For addresses, convert to bytes20
+                field_data = formats.convert(field_value, 'bytes20')
+                domain_data.append(field_data)
+    
+    # Compute the domain hash
+    domain_hash = hashes.keccak(
+        b''.join(domain_data),
+        output_format='binary'
+    )
+    
+    # Compute the domain separator
+    # Domain separator = keccak256("\x19\x01" + domainSeparator + structHash)
+    domain_separator = hashes.keccak(
+        b'\x19\x01' + hashes.keccak_text('EIP712Domain', output_format='binary') + domain_hash,
+        output_format='hex'
+    )
+    
+    return domain_separator
+
