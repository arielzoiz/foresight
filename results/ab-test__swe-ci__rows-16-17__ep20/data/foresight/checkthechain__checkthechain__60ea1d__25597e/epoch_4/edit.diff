+def standardize_transaction(transaction: spec.Transaction) -> spec.Transaction:
+    """
+    Normalize transaction dictionary by ensuring all expected fields are present.
+    
+    Args:
+        transaction: Transaction dictionary
+        
+    Returns:
+        Normalized transaction dictionary
+    """
+    # Create a copy to avoid modifying the original
+    standardized = transaction.copy()
+    
+    # Ensure required fields are present
+    if 'type' not in standardized:
+        standardized['type'] = '0x0'  # Default to legacy transaction
+    
+    # Ensure numeric fields are integers
+    if 'nonce' in standardized:
+        standardized['nonce'] = int(standardized['nonce'])
+    if 'gas_price' in standardized:
+        standardized['gas_price'] = int(standardized['gas_price'])
+    if 'gas' in standardized:
+        standardized['gas'] = int(standardized['gas'])
+    if 'value' in standardized:
+        standardized['value'] = int(standardized['value'])
+        
+    # Ensure hex fields are properly formatted
+    if 'to' in standardized and standardized['to'] is not None:
+        standardized['to'] = formats.convert(standardized['to'], 'prefix_hex')
+    if 'data' in standardized:
+        standardized['data'] = formats.convert(standardized['data'], 'prefix_hex')
+    
+    return standardized
 
 
