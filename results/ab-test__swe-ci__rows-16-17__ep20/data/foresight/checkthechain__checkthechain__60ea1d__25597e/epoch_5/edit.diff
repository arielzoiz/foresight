+from __future__ import annotations
+
+from ctc import spec
+from . import hashes
+from . import formats
+
+
+def get_domain_separator(domain: spec.Domain) -> spec.Hash:
+    """
+    Compute EIP-712 domain separator from domain data
+    
+    Implements EIP-712 domain separator calculation:
+    keccak256("EIP712Domain(string name,string version,uint256 chainId,address verifyingContract)" + 
+              keccak256(name) + 
+              keccak256(version) + 
+              chainId + 
+              verifyingContract)
+    """
+    
+    # EIP-712 domain type definition
+    domain_type = (
+        "EIP712Domain("
+        "string name,"
+        "string version,"
+        "uint256 chainId,"
+        "address verifyingContract"
+        ")"
+    )
+    
+    # Calculate type hash
+    type_hash = hashes.keccak256(domain_type)
+    
+    # Prepare domain values
+    name_hash = hashes.keccak256(domain["name"])
+    version_hash = hashes.keccak256(domain["version"])
+    chain_id = formats.convert(domain["chainId"], "integer")
+    verifying_contract = formats.convert(domain["verifyingContract"], "address")
+    
+    # Pack domain values
+    packed_values = (
+        name_hash +
+        version_hash +
+        chain_id.rjust(64, "0") +
+        verifying_contract.rjust(64, "0")
+    )
+    
+    # Calculate domain separator
+    domain_separator = hashes.keccak256(packed_values)
+    
+    return domain_separator
