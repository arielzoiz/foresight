+def standardize_transaction(transaction: typing.Mapping[str, typing.Any]) -> spec.Transaction:
+    """Normalize transaction dictionary to a standard format."""
+    # Create a standardized transaction dict with all expected fields
+    standardized = {}
+    
+    # Map common field names to standard names
+    field_mapping = {
+        'hash': 'hash',
+        'block_hash': 'block_hash',
+        'block_number': 'block_number',
+        'chain_id': 'chain_id',
+        'from': 'from',
+        'gas': 'gas',
+        'gas_price': 'gas_price',
+        'input': 'input',
+        'nonce': 'nonce',
+        'r': 'r',
+        's': 's',
+        'to': 'to',
+        'transaction_index': 'transaction_index',
+        'type': 'type',
+        'v': 'v',
+        'value': 'value',
+        # Handle variations in field names
+        'gasLimit': 'gas_limit',
+        'gasPrice': 'gas_price',
+        'data': 'input',
+        'transactionHash': 'hash',
+        'blockHash': 'block_hash',
+        'blockNumber': 'block_number',
+        'transactionIndex': 'transaction_index',
+        'value': 'value',
+    }
+    
+    # Populate standardized fields
+    for key, value in transaction.items():
+        if key in field_mapping:
+            standardized[field_mapping[key]] = value
+        else:
+            standardized[key] = value
+    
+    # Ensure all required fields are present with defaults
+    required_fields = {
+        'hash': None,
+        'block_hash': None,
+        'block_number': 0,
+        'chain_id': None,
+        'from': None,
+        'gas': 0,
+        'gas_price': 0,
+        'input': '0x',
+        'nonce': 0,
+        'r': None,
+        's': None,
+        'to': None,
+        'transaction_index': 0,
+        'type': '0x0',
+        'v': 0,
+        'value': 0,
+    }
+    
+    # Merge required fields with standardized transaction
+    for field, default_value in required_fields.items():
+        if field not in standardized:
+            standardized[field] = default_value
+            
+    # Convert values to appropriate types
+    if 'gas' in standardized and standardized['gas'] is not None:
+        standardized['gas'] = formats.convert(standardized['gas'], 'integer')
+        
+    if 'gas_price' in standardized and standardized['gas_price'] is not None:
+        standardized['gas_price'] = formats.convert(standardized['gas_price'], 'integer')
+        
+    if 'nonce' in standardized and standardized['nonce'] is not None:
+        standardized['nonce'] = formats.convert(standardized['nonce'], 'integer')
+        
+    if 'value' in standardized and standardized['value'] is not None:
+        standardized['value'] = formats.convert(standardized['value'], 'integer')
+        
+    if 'block_number' in standardized and standardized['block_number'] is not None:
+        standardized['block_number'] = formats.convert(standardized['block_number'], 'integer')
+        
+    if 'v' in standardized and standardized['v'] is not None:
+        standardized['v'] = formats.convert(standardized['v'], 'integer')
+        
+    if 'type' in standardized and standardized['type'] is not None:
+        standardized['type'] = formats.convert(standardized['type'], 'hex')
+        
+    if 'chain_id' in standardized and standardized['chain_id'] is not None:
+        standardized['chain_id'] = formats.convert(standardized['chain_id'], 'hex')
+        
+    # Ensure hex prefixes for binary data
+    if 'input' in standardized and standardized['input'] is not None:
+        standardized['input'] = formats.convert(standardized['input'], 'prefix_hex')
+        
+    if 'r' in standardized and standardized['r'] is not None:
+        standardized['r'] = formats.convert(standardized['r'], 'prefix_hex')
+        
+    if 's' in standardized and standardized['s'] is not None:
+        standardized['s'] = formats.convert(standardized['s'], 'prefix_hex')
+        
+    # Convert to TypedDict format
+    return typing.cast(spec.Transaction, standardized)
