+def get_domain_separator(domain: dict[str, typing.Any]) -> str:
+    """
+    Compute EIP-712 domain separator hash
+    """
+    # Create the domain struct
+    domain_struct = [
+        ('name', 'string'),
+        ('version', 'string'),
+        ('chainId', 'uint256'),
+        ('verifyingContract', 'address'),
+    ]
+
+    # Prepare the data for hashing
+    domain_data = []
+    for field_name, field_type in domain_struct:
+        if field_name in domain:
+            value = domain[field_name]
+            if field_type == 'string':
+                # For strings, we need to keccak hash the string
+                encoded_value = hashes.keccak_text(value)
+                domain_data.append(encoded_value)
+            elif field_type == 'uint256':
+                # For uint256, we convert to hex
+                encoded_value = formats.convert(value, 'binary')
+                domain_data.append(encoded_value)
+            elif field_type == 'address':
+                # For addresses, we convert to hex
+                encoded_value = formats.convert(value, 'binary')
+                domain_data.append(encoded_value)
+    
+    # Hash the domain data
+    domain_hash = hashes.keccak(b''.join(domain_data))
+    
+    # Return the domain separator hash
+    return formats.convert(domain_hash, 'prefix_hex')
+
