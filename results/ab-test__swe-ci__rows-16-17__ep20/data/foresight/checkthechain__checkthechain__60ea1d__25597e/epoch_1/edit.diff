diff -ruN -x .git -x __pycache__ -x *.pyc -x ._* a/src/ctc/evm/transaction_utils/transaction_standardization.py b/src/ctc/evm/transaction_utils/transaction_standardization.py
--- a/src/ctc/evm/transaction_utils/transaction_standardization.py	1970-01-01 02:00:00
+++ b/src/ctc/evm/transaction_utils/transaction_standardization.py	2026-09-21 22:01:30
@@ -0,0 +1,66 @@
+from __future__ import annotations
+
+import typing
+
+from ctc import spec
+from .. import formats
+
+
+def standardize_transaction(transaction: spec.Transaction) -> spec.Transaction:
+    """
+    Standardize a transaction dictionary to a consistent format
+    
+    This function ensures that all transaction fields are in the correct format
+    and handles differences in how various sources represent transactions.
+    """
+    # Make a copy to avoid modifying the original
+    standardized = transaction.copy()
+    
+    # Ensure all fields are properly formatted
+    if 'chain_id' in standardized:
+        standardized['chain_id'] = formats.convert(standardized['chain_id'], 'integer')
+        
+    # Handle different field names for input/data
+    if 'input' in standardized and 'data' not in standardized:
+        standardized['data'] = standardized['input']
+    elif 'data' in standardized and 'input' not in standardized:
+        standardized['input'] = standardized['data']
+    elif 'input' in standardized and 'data' in standardized:
+        # If both exist, prefer input (EIP-1559 format)
+        if standardized['input'] != standardized['data']:
+            raise ValueError("Conflicting input and data fields in transaction")
+    
+    # Ensure gas fields are integers
+    if 'gas' in standardized:
+        standardized['gas'] = formats.convert(standardized['gas'], 'integer')
+    if 'gas_price' in standardized:
+        standardized['gas_price'] = formats.convert(standardized['gas_price'], 'integer')
+    if 'max_fee_per_gas' in standardized:
+        standardized['max_fee_per_gas'] = formats.convert(standardized['max_fee_per_gas'], 'integer')
+    if 'max_priority_fee_per_gas' in standardized:
+        standardized['max_priority_fee_per_gas'] = formats.convert(standardized['max_priority_fee_per_gas'], 'integer')
+        
+    # Ensure value is integer
+    if 'value' in standardized:
+        standardized['value'] = formats.convert(standardized['value'], 'integer')
+        
+    # Ensure nonce is integer
+    if 'nonce' in standardized:
+        standardized['nonce'] = formats.convert(standardized['nonce'], 'integer')
+        
+    # Ensure transaction type is properly formatted
+    if 'type' in standardized:
+        standardized['type'] = formats.convert(standardized['type'], 'hex')
+        
+    # Ensure addresses are properly formatted
+    if 'to' in standardized:
+        standardized['to'] = formats.convert(standardized['to'], 'address')
+    if 'from' in standardized:
+        standardized['from'] = formats.convert(standardized['from'], 'address')
+        
+    # Normalize boolean fields
+    if 'access_list' in standardized:
+        if standardized['access_list'] is None:
+            standardized['access_list'] = []
+            
+    return standardized
\ No newline at end of file
