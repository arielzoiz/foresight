+            if len(init) > 1:
+                raise ValueError("Initializer for at most one field can be provided for a union "
+                                "layout (specified: {})"
+                                .format(", ".join(sorted(init.keys()))))
+            elif len(init) == 1:
+                key, value = next(iter(init.items()))
