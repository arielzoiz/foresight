+                if isinstance(field.shape, Layout):
+                    value = field.shape._convert_to_int(value)
+                return Const(value, Shape.cast(field.shape))
+            else:
+                # Empty mapping - return zero constant
+                return Const(0, self.size)
+        elif isinstance(init, Sequence):
+            # For sequences, we'll treat it as a mapping with indices as keys
