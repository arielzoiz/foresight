     def __repr__(self):
         return f"UnionLayout({self.members!r})"
 
+    def const(self, value):
+        """Create a constant value from this layout and a value."""
+        if isinstance(value, Mapping):
+            if len(value) > 1:
+                raise ValueError("Initializer for at most one field can be provided for a union "
+                                "layout (specified: {})"
+                                .format(", ".join(value.keys())))
+            if len(value) == 0:
+                return Const(0, self.size)
+            key, key_value = next(iter(value.items()))
+            field = self[key]
+            if isinstance(field.shape, Layout):
+                key_value = field.shape._convert_to_int(key_value)
+            return Const(key_value, Shape.cast(field.shape))
+        elif isinstance(value, Sequence):
+            if len(value) > 1:
+                raise ValueError("Initializer for at most one field can be provided for a union "
+                                "layout (specified: {})"
+                                .format(", ".join(str(i) for i in range(len(value)))))
+            if len(value) == 0:
+                return Const(0, self.size)
+            key_value = value[0]
+            field = self[next(iter(self._fields))]
+            if isinstance(field.shape, Layout):
+                key_value = field.shape._convert_to_int(key_value)
+            return Const(key_value, Shape.cast(field.shape))
+        else:
+            raise TypeError("Layout constant initializer must be a mapping or a sequence, not {!r}"
+                            .format(value))
 
