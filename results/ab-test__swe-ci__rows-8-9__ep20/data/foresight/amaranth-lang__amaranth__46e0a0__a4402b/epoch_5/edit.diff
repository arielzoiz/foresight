+    def const(cls, value):
+        """Create a constant value from this enumeration class and a value.
+        
+        Parameters
+        ----------
+        value : int or enum member or None
+            The value to create a constant from. If None, creates a constant with value 0.
+            
+        Returns
+        -------
+        :class:`Const`
+            A constant value of the appropriate shape.
+        """
+        if value is None:
+            # Return zero with the appropriate shape
+            return Const(0, cls.as_shape())
+        elif isinstance(value, cls):
+            # If it's already an enum member, return its value
+            return Const(value.value, cls.as_shape())
+        else:
+            # Otherwise, treat as an integer value
+            return Const(value, cls.as_shape())
+
 
