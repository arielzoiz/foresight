+class SwitchValue:
+    """A switch value expression for conditional assignment.
+
+    This class represents a switch value expression that evaluates to one of several
+    possible values based on a condition. It's used for generating conditional assignments
+    in the netlist.
+    """
+    
+    def __init__(self, test, cases):
+        self.test = test
+        self.cases = cases
+    
+    def eq(self, value):
+        # Return an assignment statement
+        from ._ast import Assign
+        return Assign(self, value)
+    
+    def __repr__(self):
+        return f"SwitchValue({self.test!r}, {self.cases!r})"
+
+
+class DuplicateElaboratable(Exception):
