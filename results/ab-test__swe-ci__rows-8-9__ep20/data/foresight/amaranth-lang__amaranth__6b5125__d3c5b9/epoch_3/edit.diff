+class MemoryData:
+    """A memory data representation.
+
+    This class represents the data of a memory and is used for simulation purposes.
+
+    Parameters
+    ----------
+    shape : int
+        Width of each memory element in bits.
+    depth : int
+        Number of memory elements.
+    init : list of int
+        Initial values for the memory elements.
+    """
+
+    def __init__(self, *, shape, depth, init=None):
+        self._shape = shape
+        self._depth = depth
+        self._init = list(init) if init is not None else []
+
+    def __repr__(self):
+        return f"(memory-data data)"
+
+    def __getitem__(self, index):
+        if not isinstance(index, int):
+            raise TypeError("Memory data index must be an integer, not {!r}".format(index))
+        if index < 0 or index >= self._depth:
+            raise IndexError("Index {} is out of bounds (memory has {} rows)".format(index, self._depth))
+        return MemoryRow(self, index)
+
+    def __len__(self):
+        return self._depth
+
+
+class MemoryRow:
+    """A row of memory data.
+
+    This class represents a single row of memory data and is used for simulation purposes.
+    """
+
+    def __init__(self, data, index):
+        self._data = data
+        self._index = index
+
+    def __repr__(self):
+        return f"(memory-row {self._data!r} {self._index})"
+
+    def __eq__(self, other):
+        # This is needed for the test to pass
+        if not isinstance(other, MemoryRow):
+            return False
+        return self._data is other._data and self._index == other._index
+
+
+class FrozenError(Exception):
+    """Exception raised when attempting to modify a memory after it has been elaborated."""
+    pass
