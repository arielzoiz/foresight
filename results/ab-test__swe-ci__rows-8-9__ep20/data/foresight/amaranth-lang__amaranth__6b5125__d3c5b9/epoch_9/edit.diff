+class SwitchValue(Value):
+    """A switch value expression.
+
+    This class represents a switch value expression that selects a value based on pattern matching
+    against a test value. It is similar to a C-style switch statement but evaluates to a value.
+    """
+    def __init__(self, test, cases, *, src_loc_at=0):
+        super().__init__(src_loc_at=src_loc_at)
+        self._test = Value.cast(test)
+        self._cases = []
+        for pattern, value in cases:
+            if isinstance(pattern, str):
+                # Normalize pattern by removing whitespace
+                pattern = "".join(pattern.split())
+            self._cases.append((pattern, Value.cast(value)))
+
+    @property
+    def test(self):
+        return self._test
+
+    @property
+    def cases(self):
+        return self._cases
+
+    def shape(self):
+        # The shape is determined by the maximum shape of all case values
+        shapes = [value.shape() for _, value in self.cases]
+        if not shapes:
+            # Default to unsigned(1) if no cases
+            return unsigned(1)
+        return Shape._unify(shapes)
+
+    def _lhs_signals(self):
+        # SwitchValue is not an assignment target
+        return super()._lhs_signals()
+
+    def _rhs_signals(self):
+        # Collect signals from test value and all case values
+        signals = self.test._rhs_signals()
+        for _, value in self.cases:
+            signals |= value._rhs_signals()
+        return signals
+
+    def __repr__(self):
+        return f"(switchvalue {self.test!r} {self.cases!r})"
+
+
