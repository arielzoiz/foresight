<?xml version="1.0" encoding="utf-8"?>
<requirements>
    <requirement>
        <location>/app/code/amaranth/lib/memory.py</location>
        <description>Memory initialization error handling has incorrect error message formatting. The error messages are formatted using f-strings instead of .format() which leads to formatting issues in the test expectations.</description>
        <contract>
            <description>Memory constructor and Init class should properly format error messages using .format() instead of f-strings to match test expectations.</description>
            <input>
                <param name="shape">Shape-like object</param>
                <param name="depth">Integer, non-negative</param>
                <param name="init">Initialization data</param>
            </input>
            <output>
                <return type="Memory">Memory object with proper error handling</return>
            </output>
            <exception type="TypeError">
                <description>When shape cannot be converted to an Amaranth shape</description>
            </exception>
            <exception type="TypeError">
                <description>When depth is not a non-negative integer</description>
            </exception>
        </contract>
        <acceptance>
            <test>tests/test_lib_memory.py::WritePortTestCase::test_signature_wrong</test>
            <test>tests/test_lib_memory.py::WritePortTestCase::test_constructor_wrong</test>
            <test>tests/test_lib_memory.py::ReadPortTestCase::test_signature_wrong</test>
            <test>tests/test_lib_memory.py::ReadPortTestCase::test_constructor_wrong</test>
            <test>tests/test_lib_memory.py::MemoryTestCase::test_constructor_wrong</test>
        </acceptance>
    </requirement>
    <requirement>
        <location>/app/code/amaranth/hdl/_ast.py</location>
        <description>Switch case handling fails with unhashable types when processing lists as case keys. The switch implementation doesn't properly handle list-type keys in the case mapping process.</description>
        <contract>
            <description>Switch class should properly handle case keys including lists, converting them to hashable representations.</description>
            <input>
                <param name="test">Value to test against</param>
                <param name="cases">Dictionary or list of case tuples</param>
            </input>
            <output>
                <return type="Switch">Switch statement with proper case handling</return>
            </output>
            <exception type="TypeError">
                <description>When case keys are unhashable (like lists)</description>
            </exception>
        </contract>
        <acceptance>
            <test>tests/test_hdl_ast.py::SwitchTestCase::test_enum_case</test>
            <test>tests/test_hdl_ast.py::SwitchTestCase::test_str_case</test>
            <test>tests/test_hdl_ast.py::SwitchTestCase::test_two_cases</test>
            <test>tests/test_hdl_ast.py::SwitchTestCase::test_int_neg_case</test>
            <test>tests/test_hdl_ast.py::SwitchTestCase::test_int_zero_width</test>
            <test>tests/test_hdl_ast.py::SwitchTestCase::test_int_zero_width_enum</test>
        </acceptance>
    </requirement>
    <requirement>
        <location>/app/code/amaranth/hdl/_ast.py</location>
        <description>Switch case pattern matching has inconsistent error message formatting for pattern validation errors.</description>
        <contract>
            <description>Switch pattern validation should produce consistent error messages matching test expectations.</description>
            <input>
                <param name="test">Value to test against</param>
                <param name="cases">Dictionary or list of case tuples</param>
            </input>
            <output>
                <return type="Switch">Switch statement with proper pattern validation</return>
            </output>
            <exception type="SyntaxError">
                <description>When pattern validation fails</description>
            </exception>
        </contract>
        <acceptance>
            <test>tests/test_hdl_ast.py::OperatorTestCase::test_matches_pattern_wrong</test>
            <test>tests/test_hdl_ast.py::OperatorTestCase::test_matches_bits_wrong</test>
            <test>tests/test_hdl_ast.py::OperatorTestCase::test_matches_width_wrong</test>
            <test>tests/test_hdl_dsl.py::DSLTestCase::test_Case_bits_wrong</test>
            <test>tests/test_hdl_dsl.py::DSLTestCase::test_Case_pattern_wrong</test>
            <test>tests/test_hdl_dsl.py::DSLTestCase::test_Case_width_wrong</test>
        </acceptance>
    </requirement>
    <requirement>
        <location>/app/code/amaranth/hdl/_mem.py</location>
        <description>MemoryData.Init class doesn't properly validate initialization data types and returns incorrect representations.</description>
        <contract>
            <description>MemoryData.Init should properly validate and represent initialization data to match test expectations.</description>
            <input>
                <param name="data">Initialization data</param>
            </input>
            <output>
                <return type="MemoryData.Init">Properly initialized data structure</return>
            </output>
        </contract>
        <acceptance>
            <test>tests/test_lib_memory.py::MemoryTestCase::test_constructor_shapecastable</test>
            <test>tests/test_lib_memory.py::MemoryTestCase::test_constructor</test>
            <test>tests/test_hdl_mem.py::MemoryDataTestCase::test_row_elab</test>
            <test>tests/test_hdl_mem.py::MemoryDataTestCase::test_row</test>
        </acceptance>
    </requirement>
    <requirement>
        <location>/app/code/amaranth/hdl/_dsl.py</location>
        <description>DSL control flow implementation has issues with FSM state management and case statement handling.</description>
        <contract>
            <description>DSL control flow constructs should properly handle FSM states and case statements with correct syntax and execution flow.</description>
            <input>
                <param name="m">Module context</param>
                <param name="cases">Case statement parameters</param>
            </input>
            <output>
                <return type="Statement">Properly constructed DSL statements</return>
            </output>
            <exception type="SyntaxError">
                <description>When DSL syntax is invalid</description>
            </exception>
        </contract>
        <acceptance>
            <test>tests/test_hdl_dsl.py::DSLTestCase::test_FSM_basic</test>
            <test>tests/test_hdl_dsl.py::DSLTestCase::test_FSM_ongoing</test>
            <test>tests/test_hdl_dsl.py::DSLTestCase::test_If_Elif</test>
            <test>tests/test_hdl_dsl.py::DSLTestCase::test_If_Elif_Else</test>
            <test>tests/test_hdl_dsl.py::DSLTestCase::test_If_nested_If</test>
            <test>tests/test_hdl_dsl.py::DSLTestCase::test_If_If</test>
        </acceptance>
    </requirement>
</requirements>