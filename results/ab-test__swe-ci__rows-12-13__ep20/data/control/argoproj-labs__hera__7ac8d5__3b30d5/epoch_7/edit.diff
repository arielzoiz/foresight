@@ -0,0 +1,32 @@
+from typing import List, Dict, Any
+from pydantic import BaseModel
+
+
+class MyInput(BaseModel):
+    a: int
+    b: str
+    c: float
+
+
+class MyOutput(BaseModel):
+    output: List[Dict[str, Any]]
+
+
+def my_function(input: MyInput) -> MyOutput:
+    return MyOutput(output=[input.dict()])
+
+
+def another_function(inputs: List[MyInput]) -> MyOutput:
+    return MyOutput(output=[inp.dict() for inp in inputs])
+
+
+def str_function(input: MyInput) -> MyOutput:
+    return MyOutput(output=[input.dict()])
+
+
+def function_kebab(a_but_kebab: int, b_but_kebab: str, c_but_kebab: float) -> MyOutput:
+    return MyOutput(output=[{"a": a_but_kebab, "b": b_but_kebab, "c": c_but_kebab}])
+
+
+def function_kebab_object(input_value: MyInput) -> MyOutput:
+    return MyOutput(output=[input_value.dict()])
