@@ -0,0 +1,32 @@
+from typing import Any, Dict, List
+from pydantic import BaseModel
+
+
+class Input(BaseModel):
+    a: int
+    b: str
+    c: float
+
+
+class Output(BaseModel):
+    output: List[Dict[str, Any]]
+
+
+def my_function(input: Input) -> Output:
+    return Output(output=[input.dict()])
+
+
+def another_function(inputs: List[Input]) -> Output:
+    return Output(output=[i.dict() for i in inputs])
+
+
+def str_function(input: Input) -> Output:
+    return Output(output=[input.dict()])
+
+
+def function_kebab(a_but_kebab: int, b_but_kebab: str, c_but_kebab: float) -> Output:
+    return Output(output=[{"a": a_but_kebab, "b": b_but_kebab, "c": c_but_kebab}])
+
+
+def function_kebab_object(input_value: Input) -> Output:
+    return Output(output=[input_value.dict()])
