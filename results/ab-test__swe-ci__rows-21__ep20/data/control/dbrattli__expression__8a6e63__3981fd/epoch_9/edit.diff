+            done.append(True)
+            # Return of a value in the generator produces StopIteration with a value
+            if ex.value is not None:
+                return self.return_(ex.value)
+            # If StopIteration has no value, we should return the zero value
+            return self.zero()
+        except RuntimeError:
+            done.append(True)
+            raise StopIteration
 
