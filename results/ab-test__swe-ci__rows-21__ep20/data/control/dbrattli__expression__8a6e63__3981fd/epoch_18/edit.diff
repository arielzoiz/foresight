+        self,
+        gen: Generator[Any, Any, Any],
+        done: list[bool],
+        value: _TSource | None = None,
+    ) -> Option[_TSource]:
+        try:
+            # Handle both regular and async generators
+            if isinstance(gen, AsyncGenerator):
+                # For async generators, we need to await the next value
+                import asyncio
+                yielded = asyncio.run(gen.__anext__()) if value is None else asyncio.run(gen.asend(value))
+            else:
+                yielded = gen.send(value)
+            return self.return_(yielded)
+        except EffectError as error:
+            # Effect errors (Nothing, Error, etc) short circuits the processing so we
+            # set `done` to `True` here.
+            done.append(True)
+            # get value from exception
+            value = error.args[0]
+            return self.return_from(value)
