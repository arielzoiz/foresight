@@ -0,0 +1,127 @@
+"""Async option builder implementation."""
+
+from abc import ABC
+from collections.abc import Callable, Generator, Awaitable
+from functools import wraps
+from typing import Any, Generic, TypeVar, cast
+
+from typing_extensions import ParamSpec
+
+from expression.core.builder import Builder
+from expression.core.error import EffectError
+from expression import Option, Some, Nothing
+
+
+_TInner = TypeVar("_TInner")
+_TOuter = TypeVar("_TOuter")
+_P = ParamSpec("_P")
+
+
+class AsyncOptionBuilder(Builder[_TInner, Awaitable[_TOuter]], ABC):
+    """Async option builder."""
+
+    def bind(self, xs: Awaitable[_TOuter], fn: Callable[[_TInner], Awaitable[_TOuter]]) -> Awaitable[_TOuter]:
+        raise NotImplementedError("AsyncOptionBuilder does not implement a bind method")
+
+    def return_(self, x: _TInner) -> Awaitable[_TOuter]:
+        raise NotImplementedError("AsyncOptionBuilder does not implement a return method")
+
+    def return_from(self, xs: Awaitable[_TOuter]) -> Awaitable[_TOuter]:
+        raise NotImplementedError("AsyncOptionBuilder does not implement a return from method")
+
+    def combine(self, xs: Awaitable[_TOuter], ys: Awaitable[_TOuter]) -> Awaitable[_TOuter]:
+        raise NotImplementedError("AsyncOptionBuilder does not implement a combine method")
+
+    def zero(self) -> Awaitable[_TOuter]:
+        raise NotImplementedError("AsyncOptionBuilder does not implement a zero method")
+
+    async def _send(
+        self,
+        gen: Generator[Any, Any, Any],
+        done: list[bool],
+        value: _TInner | None = None,
+    ) -> Awaitable[_TOuter]:
+        try:
+            yielded = gen.send(value)
+            # Handle async operations
+            if isinstance(yielded, Awaitable):
+                yielded = await yielded
+            return self.return_(yielded)
+        except EffectError as error:
+            # Effect errors (Nothing, Error, etc) short circuits the processing so we
+            # set `done` to `True` here.
+            done.append(True)
+            # get value from exception
+            value = error.args[0]
+            return self.return_from(cast("Awaitable[_TOuter]", value))
+        except StopIteration as ex:
+            done.append(True)
+            # Return of a value in the generator produces StopIteration with a value
+            if ex.value is not None:
+                return self.return_(ex.value)
+            raise
+        except RuntimeError:
+            done.append(True)
+            raise StopIteration
+
+    async def run(self, xs: Awaitable[_TOuter]) -> Awaitable[_TOuter]:
+        """Run the async effect."""
+        return xs
+
+    def __call__(
+        self,
+        fn: Callable[
+            _P,
+            Generator[_TInner | None, _TInner, _TInner | None] | Generator[_TInner | None, None, _TInner | None],
+        ],
+    ) -> Callable[_P, Awaitable[_TOuter]]:
+        """Async option builder.
+
+        Enables the use of computational expressions using coroutines.
+        Thus inside the coroutine the keywords `yield` and `yield from`
+        reassembles `yield` and `yield!` from F#.
+
+        Args:
+            fn: A function that contains a computational expression and
+                returns either a coroutine, generator or an option.
+
+        Returns:
+            A `builder` function that can wrap coroutines into builders.
+        """
+
+        @wraps(fn)
+        async def wrapper(*args: _P.args, **kw: _P.kwargs) -> Awaitable[_TOuter]:
+            gen = fn(*args, **kw)
+            done: list[bool] = []
+
+            result: Awaitable[_TOuter] | None = None
+
+            def binder(value: Any) -> Awaitable[_TOuter]:
+                ret = self._send(gen, done, value)
+                # Delay every result except the first
+                if result is not None:
+                    return self.delay(lambda: ret)
+                return ret
+
+            try:
+                result = self._send(gen, done)
+
+                while not done:
+                    cont = self.bind(result, binder)
+
+                    # Combine every result except the first
+                    if result is None:
+                        result = cont
+                    else:
+                        result = self.combine(result, cont)
+            except StopIteration:
+                pass
+
+            # If anything returns `None` (i.e raises StopIteration without a value) then
+            # we expect the effect to have a zero method implemented.
+            if result is None:
+                result = self.zero()
+
+            return self.run(result)
+
+        return wrapper
