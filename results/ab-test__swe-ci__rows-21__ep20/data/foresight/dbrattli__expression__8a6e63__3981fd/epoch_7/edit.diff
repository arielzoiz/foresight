diff -ruN -x .git -x __pycache__ -x *.pyc -x ._* a/expression/effect/seq.py b/expression/effect/seq.py
--- a/expression/effect/seq.py	2026-09-23 12:17:28
+++ b/expression/effect/seq.py	2026-09-23 12:21:12
@@ -72,5 +72,60 @@
         
         return wrapper
 
+    def _send(
+        self,
+        gen: Generator[Any, Any, Any],
+        done: list[bool],
+        value: _TSource | None = None,
+    ) -> Iterable[_TSource]:
+        """Handle sending values to generators, with special handling for async generators."""
+        try:
+            yielded = gen.send(value)
+            # Check if the yielded value is awaitable (like Result or Option)
+            if hasattr(yielded, '__await__') and not isinstance(yielded, type(gen)):
+                # Handle awaitable values (like Result or Option) - this is tricky in sync context
+                # For now, we'll treat them as regular values
+                return self.return_(yielded)
+            else:
+                return self.return_(yielded)
+        except AttributeError as ex:
+            error_msg = str(ex)
+            # Check if this is specifically an async generator error
+            if ("object is not an iterator" in error_msg or 
+                "'async_generator' object is not an iterator" in error_msg or
+                "'async_generator' object has no attribute 'send'" in error_msg):
+                # This is an async generator, but we're in a sync context, so we can't use __anext__
+                # Just fall through to default behavior - let the caller handle this appropriately
+                try:
+                    yielded = next(gen)
+                    return self.return_(yielded)
+                except StopIteration as stop_ex:
+                    done.append(True)
+                    # Return of a value in the generator produces StopIteration with a value
+                    if stop_ex.value is not None:
+                        return self.return_(stop_ex.value)
+                    raise
+            elif "'object' object has no attribute 'send'" in error_msg or "has no attribute 'send'" in error_msg:
+                # Handle iterators that don't support send (like list_iterator)
+                try:
+                    yielded = next(gen)
+                    return self.return_(yielded)
+                except StopIteration as stop_ex:
+                    done.append(True)
+                    # Return of a value in the generator produces StopIteration with a value
+                    if stop_ex.value is not None:
+                        return self.return_(stop_ex.value)
+                    raise
+            raise  # Re-raise if it's a different AttributeError
+        except StopIteration as ex:
+            done.append(True)
+            # Return of a value in the generator produces StopIteration with a value
+            if ex.value is not None:
+                return self.return_(ex.value)
+            raise
+        except RuntimeError:
+            done.append(True)
+            raise StopIteration
+
 
 __all__ = ["SeqBuilder"]
