+                if hasattr(ex, 'value') and ex.value is not None:
+                    # If we got a value, return it as Some
+                    return self.return_(ex.value)
+                elif hasattr(ex, 'value') and ex.value is None:
+                    # If we got None value, this means we should use zero() 
+                    result = self.zero()
+                else:
+                    # Default case - re-raise if no value
+                    raise
+
+            # If anything returns `None` (i.e raises StopIteration without a value) then
+            # we expect the effect to have a zero method implemented.
+            # But we also need to check if we got StopIteration with no value
+            if result is None:
+                result = self.zero()
+
+            return self.run(result)
+
+        return sync_wrapper
 
 
