+        def sync_wrapper(*args: _P.args, **kw: _P.kwargs) -> Option[_TSource]:
+            gen = fn(*args, **kw)
+            done: list[bool] = []
+
+            result: Option[_TSource] | None = None
+
+            def binder(value: Any) -> Option[_TSource]:
+                ret = self._send(gen, done, value)
+                return ret
+
+            try:
+                result = self._send(gen, done)
+                
+                while not done[0] if done else False:
+                    cont = self.bind(result, binder)
