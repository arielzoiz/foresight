     def zero(self) -> Iterable[_TSource]:
         return seq.empty
+
+    def __call__(
+        self,  # Ignored self parameter
+        fn: Callable[
+            ...,  # Use ... instead of ParamSpec to avoid import issues
+            Generator[_TSource | None, _TSource, _TSource | None] | Generator[_TSource | None, None, _TSource | None],
+        ],
+    ) -> Callable[..., Iterable[_TSource]]:
+        """Sync seq builder."""
+        def wrapper(*args, **kwargs):
+            gen = fn(*args, **kwargs)
+            done: list[bool] = []
+            result: Iterable[_TSource] | None = None
+            
+            def binder(value: Any) -> Iterable[_TSource]:
+                ret = self._send(gen, done, value)
+                return ret
+            
+            try:
+                result = self._send(gen, done)
+                
+                while not done:
+                    cont = self.bind(result, binder)
+                    
+                    # Combine every result except the first
+                    if result is None:
+                        result = cont
+                    else:
+                        result = self.combine(result, cont)
+            except StopIteration:
+                pass
+
+            # If anything returns `None` (i.e raises StopIteration without a value) then
+            # we expect the effect to have a zero method implemented.
+            if result is None:
+                result = self.zero()
+
+            return result
+        
+        return wrapper
 
 
