+# -*- coding: utf-8 -*-
+from collections.abc import Callable
+from contextlib import contextmanager
+import traceback
+from typing import Generator, Optional
+
+from httpdbg.hooks.utils import getcallargs
+from httpdbg.initiator import httpdbg_initiator
+from httpdbg.records import HTTPRecords
+
+
+# Global registry to store route information for functions
+_route_registry = {}
+
+
+def set_hook_for_flask(records: HTTPRecords, method: Callable, route_rule: Optional[str] = None, error_code: Optional[int] = None):
+    """Set up a hook for Flask methods that captures route information."""
+    
+    # Build full label with function arguments
+    def hook(*args, **kwargs):
+        # Extract function arguments for group labeling
+        try:
+            callargs = getcallargs(method, *args, **kwargs)
+        except Exception:
+            callargs = {}
+            
+        # Build full label with function arguments
+        try:
+            arg_list = []
+            for key, value in callargs.items():
+                if key != 'self':
+                    arg_list.append(f"{key}={repr(value)}")
+            full_label = f"{method.__name__}({', '.join(arg_list)})"
+        except Exception:
+            full_label = method.__name__
+            
+        # Determine label based on Flask metadata
+        label = ""
+        
+        # Check if we have route information stored
+        if route_rule:
+            label = f"@app.route(\"{route_rule}\")"
+        elif error_code:
+            # Handle error handlers
+            label = f"@app.errorhandler({error_code})"
+        else:
+            # Try to get route info from registry
+            if method in _route_registry:
+                label = f"@app.route(\"{_route_registry[method]}\")"
+            else:
+                # Default to function name
+                label = method.__name__
+            
+        try:
+            with httpdbg_initiator(
+                records, traceback.extract_stack(), method, *args, **kwargs, 
+                full_label=full_label,
+                label=label
+            ) as initiator_and_group:
+                ret = method(*args, **kwargs)
+            return ret
+        except Exception as ex:
+            raise
+
+    return hook
+
+
+@contextmanager
+def hook_flask(records: HTTPRecords) -> Generator[None, None, None]:
+    """Hook Flask application to capture route information."""
+    
+    # Import here to avoid circular imports
+    try:
+        import flask
+        
+        # Store original Flask functions
+        original_route = flask.Flask.route
+        original_errorhandler = flask.Flask.errorhandler
+        
+        # Create a wrapper for route decorator
+        def route_wrapper(self, rule, **options):
+            def decorator(f):
+                # Store route information in our registry BEFORE wrapping
+                _route_registry[f] = rule
+                
+                # Create the hooked version of the function
+                hooked_func = set_hook_for_flask(records, f, route_rule=rule)
+                
+                # Make sure the hooked function keeps the same name as the original
+                # to avoid endpoint conflicts in Flask
+                hooked_func.__name__ = f.__name__
+                hooked_func.__qualname__ = f.__qualname__
+                hooked_func.__annotations__ = getattr(f, '__annotations__', {})
+                
+                # Apply the original route decorator to the hooked function
+                # This ensures Flask handles endpoint registration correctly
+                # while still allowing us to hook the function execution
+                return original_route(self, rule, **options)(hooked_func)
+            return decorator
+            
+        # Create a wrapper for errorhandler decorator  
+        def errorhandler_wrapper(self, code):
+            def decorator(f):
+                # Create the hooked version of the function
+                hooked_func = set_hook_for_flask(records, f, error_code=code)
+                
+                # Apply the original errorhandler decorator to the hooked function
+                return original_errorhandler(self, code)(hooked_func)
+            return decorator
+            
+        # Monkey patch Flask's decorators
+        flask.Flask.route = route_wrapper
+        flask.Flask.errorhandler = errorhandler_wrapper
+        
+        try:
+            yield
+        finally:
+            # Restore original functions
+            flask.Flask.route = original_route
+            flask.Flask.errorhandler = original_errorhandler
+            
+    except ImportError:
+        # Flask not available, just yield
+        yield
