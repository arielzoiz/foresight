+def list_callables_from_flask_app(records: HTTPRecords, flask_app) -> List[Any]:
+    """Hook Flask app view functions and error handlers."""
+    callables = []
+    
+    try:
+        # Hook view functions from this Flask app
+        if hasattr(flask_app, 'view_functions'):
+            for endpoint, func in flask_app.view_functions.items():
+                # Check if the function is not already hooked
+                if not hasattr(func, '__httpdbg__'):
+                    try:
+                        if inspect.iscoroutinefunction(func):
+                            decorated = decorate(
+                                records,
+                                func,
+                                set_hook_for_generic_async,
+                            )
+                            callables.append(decorated)
+                        else:
+                            decorated = decorate(
+                                records,
+                                func,
+                                set_hook_for_generic,
+                            )
+                            callables.append(decorated)
+                    except Exception:
+                        # If decoration fails, continue with other functions
+                        pass
+                        
+        # Hook error handlers
+        if hasattr(flask_app, 'error_handlers'):
+            for error_code, handler in flask_app.error_handlers.items():
+                # Check if the handler is not already hooked
+                if not hasattr(handler, '__httpdbg__'):
+                    try:
+                        if inspect.iscoroutinefunction(handler):
+                            decorated = decorate(
+                                records,
+                                handler,
+                                set_hook_for_generic_async,
+                            )
+                            callables.append(decorated)
+                        else:
+                            decorated = decorate(
+                                records,
+                                handler,
+                                set_hook_for_generic,
+                            )
+                            callables.append(decorated)
+                    except Exception:
+                        # If decoration fails, continue with other handlers
+                        pass
+    except Exception:
+        # If we can't process Flask app, continue normally
+        pass
+    
     return callables
